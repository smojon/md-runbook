{
  "commands": [
    {
      "command": "mdRunbook.runCellInEditor",
      "title": "Run Code Block in Text Editor",
      "category": "md-runbook",
      "icon": "$(play)"
    },
    {
      "command": "mdRunbook.runCellsBelowInEditor",
      "title": "Run Code Block and Below in Text Editor",
      "category": "md-runbook",
      "icon": "$(run-below)"
    },
    {
      "command": "mdRunbook.exportReport",
      "title": "Export Report (HTML)",
      "category": "md-runbook",
      "icon": "$(output)"
    },
    {
      "command": "mdRunbook.exportReportPdf",
      "title": "Export Report (PDF)",
      "category": "md-runbook",
      "icon": "$(file-pdf)"
    }
  ],
  "menus": {
    "explorer/context": [
      {
        "command": "mdRunbook.exportReport",
        "when": "resourceExtname == .md",
        "group": "navigation@101"
      },
      {
        "command": "mdRunbook.exportReportPdf",
        "when": "resourceExtname == .md",
        "group": "navigation@102"
      }
    ],
    "notebook/toolbar": [
      {
        "command": "mdRunbook.exportReport",
        "when": "notebookType == md-runbook",
        "group": "navigation/execute@100"
      }
    ],
    "commandPalette": [
      {
        "command": "mdRunbook.runCellInEditor",
        "when": "editorLangId == markdown"
      },
      {
        "command": "mdRunbook.runCellsBelowInEditor",
        "when": "editorLangId == markdown"
      },
      {
        "command": "mdRunbook.exportReport",
        "when": "notebookType == md-runbook || resourceExtname == .md"
      },
      {
        "command": "mdRunbook.exportReportPdf",
        "when": "notebookType == md-runbook || resourceExtname == .md"
      }
    ]
  },
  "configuration": {
    "properties": {
      "mdRunbook.codeLens.enabled": {
        "type": "boolean",
        "default": false,
        "markdownDescription": "Show **▶ Run** links above code blocks in the plain Markdown editor. Off by default: text-editor runs skip per-cell options and secret injection (proposed and assistant-written cells are refused, risky commands still ask). Can only be set in user settings, so a workspace cannot change it.",
        "scope": "machine"
      },
      "mdRunbook.report.folder": {
        "type": "string",
        "default": "",
        "markdownDescription": "Folder for `<name>.report.html` written by **Export Report (HTML)**. Empty = next to the `.md` file. A relative path is resolved against the file's workspace folder (or the file's folder outside a workspace); an absolute path is used as is. Can only be set in user settings, so a workspace cannot change it.",
        "scope": "machine"
      }
    }
  }
}
