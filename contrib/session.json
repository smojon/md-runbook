{
  "commands": [
    {
      "command": "mdRunbook.restartSession",
      "title": "Restart Session",
      "category": "md-runbook",
      "icon": "$(debug-restart)"
    },
    {
      "command": "mdRunbook.stopSession",
      "title": "Stop Session",
      "category": "md-runbook",
      "icon": "$(debug-stop)"
    },
    {
      "command": "mdRunbook.toggleSessionMode",
      "title": "Toggle Session Mode",
      "category": "md-runbook",
      "icon": "$(terminal)"
    },
    {
      "command": "mdRunbook.sessionModeOn",
      "title": "Session: on",
      "category": "md-runbook",
      "icon": "$(terminal)"
    },
    {
      "command": "mdRunbook.sessionModeOff",
      "title": "Session: off",
      "category": "md-runbook",
      "icon": "$(debug-disconnect)"
    },
    {
      "command": "mdRunbook.sessionMenu",
      "title": "Session…",
      "category": "md-runbook"
    }
  ],
  "menus": {
    "commandPalette": [
      {
        "command": "mdRunbook.restartSession",
        "when": "notebookType == md-runbook"
      },
      {
        "command": "mdRunbook.stopSession",
        "when": "notebookType == md-runbook"
      },
      {
        "command": "mdRunbook.toggleSessionMode",
        "when": "notebookType == md-runbook"
      },
      {
        "command": "mdRunbook.sessionMenu",
        "when": "notebookType == md-runbook"
      },
      {
        "command": "mdRunbook.sessionModeOn",
        "when": "false"
      },
      {
        "command": "mdRunbook.sessionModeOff",
        "when": "false"
      }
    ],
    "notebook/toolbar": [
      {
        "command": "mdRunbook.sessionModeOn",
        "when": "notebookType == md-runbook && mdRunbook.sessionMode == session",
        "group": "navigation/execute@97"
      },
      {
        "command": "mdRunbook.sessionModeOff",
        "when": "notebookType == md-runbook && mdRunbook.sessionMode != session",
        "group": "navigation/execute@97"
      }
    ]
  },
  "configuration": {
    "properties": {
      "mdRunbook.execution.mode": {
        "type": "string",
        "enum": [
          "isolated",
          "session"
        ],
        "enumDescriptions": [
          "Every cell runs in a new shell process.",
          "Each runbook keeps one shell process per shell (bash, PowerShell), so `cd`, variables, functions and logins carry over between cells. cmd cells still run isolated."
        ],
        "default": "isolated",
        "markdownDescription": "Default for how cells are run. `session` keeps one long-lived bash and PowerShell process per runbook, so state carries over between cells. A runbook can override this with `mode: session` / `mode: isolated` in its front matter, and **md-runbook: Toggle Session Mode** switches a single runbook."
      },
      "mdRunbook.session.resetOnRunAll": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "In session mode, start **Run All** in a fresh session, so a full run never depends on (or exposes) state left by earlier runs. Single cells, ranges and **Resume Run** keep the session. Can only be set in user settings, so a workspace cannot change it.",
        "scope": "machine"
      }
    }
  }
}
