{
  "commands": [
    {
      "command": "mdRunbook.runLine",
      "title": "Run Line or Selection",
      "category": "md-runbook",
      "icon": "$(play)"
    },
    {
      "command": "mdRunbook.runLinesOneByOne",
      "title": "Run Lines One by One",
      "category": "md-runbook",
      "icon": "$(list-ordered)"
    },
    {
      "command": "mdRunbook.stepThroughLines",
      "title": "Step Through Lines",
      "category": "md-runbook",
      "icon": "$(debug-step-into)"
    },
    {
      "command": "mdRunbook.stepThroughFromLine",
      "title": "Step Through from This Line",
      "category": "md-runbook",
      "icon": "$(debug-step-into)"
    },
    {
      "command": "mdRunbook.stepNext",
      "title": "Run Next Line",
      "category": "md-runbook",
      "icon": "$(debug-step-over)"
    },
    {
      "command": "mdRunbook.stepContinue",
      "title": "Run Remaining Lines",
      "category": "md-runbook",
      "icon": "$(debug-continue)"
    },
    {
      "command": "mdRunbook.stepStop",
      "title": "Stop Stepping",
      "category": "md-runbook",
      "icon": "$(debug-stop)"
    },
    {
      "command": "mdRunbook.runCheckedLines",
      "title": "Run Checked Lines",
      "category": "md-runbook",
      "icon": "$(checklist)"
    },
    {
      "command": "mdRunbook.clearCheckedLines",
      "title": "Uncheck All Lines",
      "category": "md-runbook"
    },
    {
      "command": "mdRunbook.runLineAt",
      "title": "Run This Line",
      "category": "md-runbook"
    },
    {
      "command": "mdRunbook.toggleLineCheck",
      "title": "Check This Line",
      "category": "md-runbook"
    },
    {
      "command": "mdRunbook.runSelection",
      "title": "Run Selection",
      "category": "md-runbook",
      "icon": "$(play)"
    },
    {
      "command": "mdRunbook.runCursorLine",
      "title": "Run This Line",
      "category": "md-runbook",
      "icon": "$(play)"
    },
    {
      "command": "mdRunbook.stepThroughFromSelection",
      "title": "Step Through from Selection",
      "category": "md-runbook",
      "icon": "$(debug-step-into)"
    }
  ],
  "menus": {
    "notebook/cell/execute": [
      {
        "command": "mdRunbook.runSelection",
        "when": "notebookType == md-runbook && notebookCellType == code && mdRunbook.cellSelection",
        "group": "mdRunbook-lines@1"
      },
      {
        "command": "mdRunbook.stepThroughFromSelection",
        "when": "notebookType == md-runbook && notebookCellType == code && mdRunbook.cellSelection",
        "group": "mdRunbook-lines@2"
      },
      {
        "command": "mdRunbook.runLinesOneByOne",
        "when": "notebookType == md-runbook && notebookCellType == code",
        "group": "mdRunbook-lines@3"
      },
      {
        "command": "mdRunbook.stepThroughLines",
        "when": "notebookType == md-runbook && notebookCellType == code",
        "group": "mdRunbook-lines@4"
      },
      {
        "command": "mdRunbook.runCheckedLines",
        "when": "notebookType == md-runbook && notebookCellType == code && mdRunbook.hasCheckedLines",
        "group": "mdRunbook-lines@5"
      },
      {
        "command": "mdRunbook.clearCheckedLines",
        "when": "notebookType == md-runbook && notebookCellType == code && mdRunbook.hasCheckedLines",
        "group": "mdRunbook-lines@6"
      }
    ],
    "notebook/cell/title": [
      {
        "command": "mdRunbook.stepNext",
        "when": "notebookType == md-runbook && mdRunbook.stepPaused && notebookCellExecutionState == executing",
        "group": "inline/cell@1"
      },
      {
        "command": "mdRunbook.stepContinue",
        "when": "notebookType == md-runbook && mdRunbook.stepPaused && notebookCellExecutionState == executing",
        "group": "inline/cell@2"
      },
      {
        "command": "mdRunbook.stepStop",
        "when": "notebookType == md-runbook && mdRunbook.stepPaused && notebookCellExecutionState == executing",
        "group": "inline/cell@3"
      }
    ],
    "editor/context": [
      {
        "command": "mdRunbook.runSelection",
        "when": "resourceScheme == vscode-notebook-cell && resourceExtname == .md && editorLangId != markdown && editorHasSelection",
        "group": "mdRunbook@1"
      },
      {
        "command": "mdRunbook.stepThroughFromSelection",
        "when": "resourceScheme == vscode-notebook-cell && resourceExtname == .md && editorLangId != markdown && editorHasSelection",
        "group": "mdRunbook@2"
      },
      {
        "command": "mdRunbook.runCursorLine",
        "when": "resourceScheme == vscode-notebook-cell && resourceExtname == .md && editorLangId != markdown && !editorHasSelection",
        "group": "mdRunbook@1"
      },
      {
        "command": "mdRunbook.stepThroughFromLine",
        "when": "resourceScheme == vscode-notebook-cell && resourceExtname == .md && editorLangId != markdown && !editorHasSelection",
        "group": "mdRunbook@2"
      }
    ],
    "commandPalette": [
      {
        "command": "mdRunbook.runLine",
        "when": "notebookType == md-runbook"
      },
      {
        "command": "mdRunbook.runLinesOneByOne",
        "when": "notebookType == md-runbook"
      },
      {
        "command": "mdRunbook.stepThroughLines",
        "when": "notebookType == md-runbook"
      },
      {
        "command": "mdRunbook.stepThroughFromLine",
        "when": "notebookType == md-runbook"
      },
      {
        "command": "mdRunbook.stepNext",
        "when": "mdRunbook.stepPaused"
      },
      {
        "command": "mdRunbook.stepContinue",
        "when": "mdRunbook.stepPaused"
      },
      {
        "command": "mdRunbook.stepStop",
        "when": "mdRunbook.stepPaused"
      },
      {
        "command": "mdRunbook.runCheckedLines",
        "when": "notebookType == md-runbook"
      },
      {
        "command": "mdRunbook.clearCheckedLines",
        "when": "notebookType == md-runbook"
      },
      {
        "command": "mdRunbook.runLineAt",
        "when": "false"
      },
      {
        "command": "mdRunbook.toggleLineCheck",
        "when": "false"
      },
      {
        "command": "mdRunbook.runSelection",
        "when": "false"
      },
      {
        "command": "mdRunbook.runCursorLine",
        "when": "false"
      },
      {
        "command": "mdRunbook.stepThroughFromSelection",
        "when": "false"
      }
    ]
  },
  "keybindings": [
    {
      "command": "mdRunbook.runLine",
      "key": "ctrl+alt+enter",
      "mac": "cmd+alt+enter",
      "when": "notebookType == md-runbook && notebookCellEditorFocused && notebookCellType == code"
    },
    {
      "command": "mdRunbook.stepNext",
      "key": "f10",
      "when": "mdRunbook.stepPaused && !inDebugMode"
    },
    {
      "command": "mdRunbook.stepContinue",
      "key": "f5",
      "when": "mdRunbook.stepPaused && !inDebugMode"
    },
    {
      "command": "mdRunbook.stepStop",
      "key": "shift+f5",
      "when": "mdRunbook.stepPaused && !inDebugMode"
    }
  ]
}
