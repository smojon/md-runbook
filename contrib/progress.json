{
  "commands": [
    { "command": "mdRunbook.markStepDone", "title": "Mark Step Done", "category": "md-runbook", "icon": "$(check)" },
    { "command": "mdRunbook.markStepSkipped", "title": "Mark Step Skipped", "category": "md-runbook", "icon": "$(debug-step-over)" },
    { "command": "mdRunbook.unmarkStep", "title": "Unmark Step", "category": "md-runbook" },
    { "command": "mdRunbook.checkNextItem", "title": "Check Next Item", "category": "md-runbook", "icon": "$(checklist)" },
    { "command": "mdRunbook.resumeRun", "title": "Resume Run", "category": "md-runbook", "icon": "$(debug-continue)" },
    { "command": "mdRunbook.clearOutputsAbove", "title": "Clear Outputs Above", "category": "md-runbook" },
    { "command": "mdRunbook.clearOutputsBelow", "title": "Clear Outputs Below", "category": "md-runbook" },
    { "command": "mdRunbook.revealNextStep", "title": "Go to Next Step", "category": "md-runbook" }
  ],
  "menus": {
    "notebook/cell/title": [
      { "command": "mdRunbook.markStepDone", "when": "notebookType == md-runbook && notebookCellType == code", "group": "mdRunbook-progress@1" },
      { "command": "mdRunbook.markStepSkipped", "when": "notebookType == md-runbook && notebookCellType == code", "group": "mdRunbook-progress@2" },
      { "command": "mdRunbook.unmarkStep", "when": "notebookType == md-runbook && notebookCellType == code", "group": "mdRunbook-progress@3" },
      { "command": "mdRunbook.checkNextItem", "when": "notebookType == md-runbook && notebookCellType == markup", "group": "mdRunbook-progress@1" },
      { "command": "mdRunbook.clearOutputsAbove", "when": "notebookType == md-runbook", "group": "mdRunbook-clear@1" },
      { "command": "mdRunbook.clearOutputsBelow", "when": "notebookType == md-runbook", "group": "mdRunbook-clear@2" }
    ],
    "notebook/toolbar": [
      { "command": "mdRunbook.resumeRun", "when": "notebookType == md-runbook", "group": "navigation/execute@10" }
    ],
    "commandPalette": [
      { "command": "mdRunbook.markStepDone", "when": "notebookType == md-runbook" },
      { "command": "mdRunbook.markStepSkipped", "when": "notebookType == md-runbook" },
      { "command": "mdRunbook.unmarkStep", "when": "notebookType == md-runbook" },
      { "command": "mdRunbook.checkNextItem", "when": "notebookType == md-runbook" },
      { "command": "mdRunbook.resumeRun", "when": "notebookType == md-runbook" },
      { "command": "mdRunbook.clearOutputsAbove", "when": "notebookType == md-runbook" },
      { "command": "mdRunbook.clearOutputsBelow", "when": "notebookType == md-runbook" },
      { "command": "mdRunbook.revealNextStep", "when": "notebookType == md-runbook" }
    ]
  },
  "configuration": {
    "properties": {
      "mdRunbook.progress.statusBar": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "Show the active runbook's progress in the status bar (e.g. `4/7 · ✗ step 5`). Click it to go to the failed or next pending step."
      }
    }
  }
}
