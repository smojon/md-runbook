{
  "name": "md-runbook",
  "displayName": "md-runbook",
  "description": "Open Markdown files as notebooks: run shell code blocks and store their output inside the same .md file.",
  "version": "0.1.0",
  "publisher": "smojon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smojon/md-runbook.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20"
  },
  "categories": [
    "Notebooks"
  ],
  "keywords": [
    "markdown",
    "notebook",
    "runbook",
    "shell",
    "powershell"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "notebooks": [
      {
        "type": "md-runbook",
        "displayName": "Markdown Runbook",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mdRunbook.openAsRunbook",
        "title": "Open as Runbook",
        "category": "md-runbook",
        "icon": "$(notebook)"
      },
      {
        "command": "mdRunbook.openAsText",
        "title": "Open as Markdown Text",
        "category": "md-runbook",
        "icon": "$(markdown)"
      },
      {
        "command": "mdRunbook.clearAllOutputs",
        "title": "Clear All Outputs",
        "category": "md-runbook",
        "icon": "$(clear-all)"
      },
      {
        "command": "mdRunbook.setSecret",
        "title": "Set Secret",
        "category": "md-runbook"
      },
      {
        "command": "mdRunbook.deleteSecret",
        "title": "Delete Secret",
        "category": "md-runbook"
      },
      {
        "command": "mdRunbook.listSecrets",
        "title": "List Secrets",
        "category": "md-runbook"
      },
      {
        "command": "mdRunbook.resetInputs",
        "title": "Reset Inputs",
        "category": "md-runbook"
      },
      {
        "command": "mdRunbook.setParameters",
        "title": "Set Parameters",
        "category": "md-runbook"
      },
      {
        "command": "mdRunbook.markStepDone",
        "title": "Mark Step Done",
        "category": "md-runbook",
        "icon": "$(check)"
      },
      {
        "command": "mdRunbook.markStepSkipped",
        "title": "Mark Step Skipped",
        "category": "md-runbook",
        "icon": "$(debug-step-over)"
      },
      {
        "command": "mdRunbook.unmarkStep",
        "title": "Unmark Step",
        "category": "md-runbook"
      },
      {
        "command": "mdRunbook.checkNextItem",
        "title": "Check Next Item",
        "category": "md-runbook",
        "icon": "$(checklist)"
      },
      {
        "command": "mdRunbook.resumeRun",
        "title": "Resume Run",
        "category": "md-runbook",
        "icon": "$(debug-continue)"
      },
      {
        "command": "mdRunbook.clearOutputsAbove",
        "title": "Clear Outputs Above",
        "category": "md-runbook"
      },
      {
        "command": "mdRunbook.clearOutputsBelow",
        "title": "Clear Outputs Below",
        "category": "md-runbook"
      },
      {
        "command": "mdRunbook.revealNextStep",
        "title": "Go to Next Step",
        "category": "md-runbook"
      },
      {
        "command": "mdRunbook.runCellInEditor",
        "title": "Run Code Block in Text Editor",
        "category": "md-runbook",
        "icon": "$(play)"
      },
      {
        "command": "mdRunbook.runCellsBelowInEditor",
        "title": "Run Code Block and Below in Text Editor",
        "category": "md-runbook",
        "icon": "$(run-below)"
      },
      {
        "command": "mdRunbook.exportReport",
        "title": "Export Report (HTML)",
        "category": "md-runbook",
        "icon": "$(output)"
      },
      {
        "command": "mdRunbook.runAllAsCopy",
        "title": "Run All as Copy",
        "category": "md-runbook",
        "icon": "$(files)"
      },
      {
        "command": "mdRunbook.compareWithPreviousRun",
        "title": "Compare With Previous Run",
        "category": "md-runbook",
        "icon": "$(diff)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mdRunbook.openAsRunbook",
          "when": "resourceExtname == .md",
          "group": "navigation@99"
        },
        {
          "command": "mdRunbook.clearAllOutputs",
          "when": "resourceExtname == .md",
          "group": "navigation@100"
        },
        {
          "command": "mdRunbook.exportReport",
          "when": "resourceExtname == .md",
          "group": "navigation@101"
        }
      ],
      "editor/title": [
        {
          "command": "mdRunbook.openAsRunbook",
          "when": "resourceLangId == markdown && activeEditor != workbench.editor.notebook",
          "group": "navigation"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "mdRunbook.openAsText",
          "when": "notebookType == md-runbook",
          "group": "navigation/execute@99"
        },
        {
          "command": "mdRunbook.resumeRun",
          "when": "notebookType == md-runbook",
          "group": "navigation/execute@10"
        },
        {
          "command": "mdRunbook.exportReport",
          "when": "notebookType == md-runbook",
          "group": "navigation/execute@100"
        },
        {
          "command": "mdRunbook.runAllAsCopy",
          "when": "notebookType == md-runbook && config.mdRunbook.output.mode == copy",
          "group": "navigation/execute@1"
        },
        {
          "command": "mdRunbook.runAllAsCopy",
          "when": "notebookType == md-runbook && config.mdRunbook.output.mode != copy",
          "group": "navigation/execute@98"
        }
      ],
      "commandPalette": [
        {
          "command": "mdRunbook.openAsRunbook",
          "when": "resourceExtname == .md"
        },
        {
          "command": "mdRunbook.openAsText",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.clearAllOutputs",
          "when": "notebookType == md-runbook || resourceExtname == .md"
        },
        {
          "command": "mdRunbook.resetInputs",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.setParameters",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.markStepDone",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.markStepSkipped",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.unmarkStep",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.checkNextItem",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.resumeRun",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.clearOutputsAbove",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.clearOutputsBelow",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.revealNextStep",
          "when": "notebookType == md-runbook"
        },
        {
          "command": "mdRunbook.runCellInEditor",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdRunbook.runCellsBelowInEditor",
          "when": "editorLangId == markdown"
        },
        {
          "command": "mdRunbook.exportReport",
          "when": "notebookType == md-runbook || resourceExtname == .md"
        },
        {
          "command": "mdRunbook.runAllAsCopy",
          "when": "notebookType == md-runbook || resourceExtname == .md"
        },
        {
          "command": "mdRunbook.compareWithPreviousRun",
          "when": "notebookType == md-runbook"
        }
      ],
      "notebook/cell/title": [
        {
          "command": "mdRunbook.markStepDone",
          "when": "notebookType == md-runbook && notebookCellType == code",
          "group": "mdRunbook-progress@1"
        },
        {
          "command": "mdRunbook.markStepSkipped",
          "when": "notebookType == md-runbook && notebookCellType == code",
          "group": "mdRunbook-progress@2"
        },
        {
          "command": "mdRunbook.unmarkStep",
          "when": "notebookType == md-runbook && notebookCellType == code",
          "group": "mdRunbook-progress@3"
        },
        {
          "command": "mdRunbook.checkNextItem",
          "when": "notebookType == md-runbook && notebookCellType == markup",
          "group": "mdRunbook-progress@1"
        },
        {
          "command": "mdRunbook.clearOutputsAbove",
          "when": "notebookType == md-runbook",
          "group": "mdRunbook-clear@1"
        },
        {
          "command": "mdRunbook.clearOutputsBelow",
          "when": "notebookType == md-runbook",
          "group": "mdRunbook-clear@2"
        },
        {
          "command": "mdRunbook.compareWithPreviousRun",
          "when": "notebookType == md-runbook && notebookCellType == code && notebookCellHasOutputs",
          "group": "md-runbook@1"
        }
      ]
    },
    "configuration": {
      "title": "md-runbook",
      "properties": {
        "mdRunbook.output.persist": {
          "type": "boolean",
          "default": true,
          "description": "Write cell outputs into the .md file on save, as an output block after each code block."
        },
        "mdRunbook.output.maxLines": {
          "type": "integer",
          "default": 2000,
          "minimum": 0,
          "description": "Maximum lines of output written to the file (head and tail are kept, with a note). 0 = unlimited."
        },
        "mdRunbook.output.stripAnsi": {
          "type": "boolean",
          "default": true,
          "description": "Remove ANSI escape codes (colours, cursor movement) from output written to the file."
        },
        "mdRunbook.redaction.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Redact secrets from output before it is written to the file."
        },
        "mdRunbook.redaction.useDefaultPatterns": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use the built-in patterns: Bearer tokens, JWTs, `password`/`secret`/`token`/`api_key` key-value pairs, PEM private keys, `Authorization`/`Cookie` headers, URL credentials, OpenShift/GitHub/AWS tokens."
        },
        "mdRunbook.redaction.patterns": {
          "type": "array",
          "default": [],
          "markdownDescription": "Additional JavaScript regular expressions; each whole match is replaced with `[REDACTED]`. Use lookbehind to keep context, e.g. `(?<=X-Api-Key: )\\\\S+`. Items are strings or `{ \"pattern\": \"...\", \"flags\": \"i\" }`.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "pattern": {
                    "type": "string"
                  },
                  "flags": {
                    "type": "string"
                  }
                },
                "required": [
                  "pattern"
                ]
              }
            ]
          }
        },
        "mdRunbook.redaction.applyToLiveOutput": {
          "type": "boolean",
          "default": false,
          "description": "Also redact the output shown live in the editor, not only what is written to disk."
        },
        "mdRunbook.execution.stopOnFailure": {
          "type": "boolean",
          "default": true,
          "description": "When running several cells (Run All, Run Above/Below), stop at the first cell that fails, times out or is cancelled."
        },
        "mdRunbook.execution.timeoutSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Kill a cell (and its whole process tree) after this many seconds. 0 = no timeout."
        },
        "mdRunbook.execution.env": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra environment variables for every cell."
        },
        "mdRunbook.shell.bashPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to bash for `sh`/`bash` blocks. On Windows, Git Bash is found automatically (Program Files, LocalAppData, Scoop, next to `git.exe`); the WSL launcher is never used."
        },
        "mdRunbook.shell.pwshPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to PowerShell for `pwsh`/`powershell` blocks. Default: `pwsh` on PATH, falling back to Windows PowerShell (`powershell.exe`)."
        },
        "mdRunbook.execution.confirm": {
          "type": "string",
          "enum": [
            "patterns",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask before running a cell that matches `mdRunbook.execution.confirmPatterns`.",
            "Ask before running every cell.",
            "Never ask (cells with the `confirm` option still ask)."
          ],
          "default": "patterns",
          "markdownDescription": "When to show a confirmation dialog before running a cell. The `confirm` / `no-confirm` cell options override this per cell."
        },
        "mdRunbook.execution.confirmPatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\\b(delete|drain|cordon|scale\\s+.*--replicas=0)\\b",
            "\\brm\\s+-[a-z]*r[a-z]*f",
            "--force\\b",
            "\\bRemove-Item\\b.*-Recurse",
            "\\bdrop\\s+(table|database)\\b"
          ],
          "markdownDescription": "JavaScript regular expressions (case-insensitive) for risky commands. A cell whose text matches one asks for confirmation before it runs; declining records it as `exit=skipped`."
        },
        "mdRunbook.output.recordContext": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "Commands whose first output line is recorded as an attribute of each output block, e.g. `{ \"context\": \"kubectl config current-context\" }` writes `context=prod-eu`. Run through the platform shell in the .md file's folder with a 5 s timeout; failures record `unknown`."
        },
        "mdRunbook.output.recordContextCacheSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Reuse recorded context values for this many seconds per runbook instead of running the commands before every cell. 0 = run them every time."
        },
        "mdRunbook.statusBar.contextAttr": {
          "type": "string",
          "default": "context",
          "markdownDescription": "Which `mdRunbook.output.recordContext` attribute to show in the status bar for the active runbook."
        },
        "mdRunbook.secrets.inject": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "markdownDescription": "Names of stored secrets (**md-runbook: Set Secret**) passed to every cell as environment variables of the same name. Their values are always redacted."
        },
        "mdRunbook.execution.envFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "A `.env` file whose `KEY=VALUE` lines are passed to every cell as environment variables, e.g. `.env` or `${workspaceFolder}/.env`. Relative paths are relative to the runbook's folder. A missing file is ignored."
        },
        "mdRunbook.redaction.redactKnownSecrets": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Redact the values loaded from `mdRunbook.execution.envFile` (exact match) from live and saved output. Stored secrets and secret inputs are always redacted."
        },
        "mdRunbook.params.useDefaults": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Use a runbook parameter's front-matter default without asking. Parameters without a default are still asked for."
        },
        "mdRunbook.progress.statusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the active runbook's progress in the status bar (e.g. `4/7 · ✗ step 5`). Click it to go to the failed or next pending step."
        },
        "mdRunbook.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show **▶ Run** / **▶ Run below** and the last result above each runnable code block in the plain Markdown text editor."
        },
        "mdRunbook.report.folder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for `<name>.report.html` written by **Export Report (HTML)**. Empty = next to the `.md` file. A relative path is resolved against the file's workspace folder (or the file's folder outside a workspace); an absolute path is used as is."
        },
        "mdRunbook.output.historySize": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "When a cell is re-run, keep up to this many earlier outputs in a collapsed `<details>` block after the latest output. `0` = off (re-running drops any existing history)."
        },
        "mdRunbook.output.mode": {
          "type": "string",
          "enum": [
            "inPlace",
            "copy"
          ],
          "enumDescriptions": [
            "Run cells in the runbook itself and write outputs into it.",
            "Treat runbooks as templates: show Run All as Copy first in the notebook toolbar and suggest it when cells are run in place."
          ],
          "default": "inPlace",
          "description": "Where runs are recorded."
        },
        "mdRunbook.output.copyFolder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for **Run All as Copy**, relative to the runbook's folder (or absolute). Empty = next to the runbook. Cells of a copy still run in the original runbook's folder."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "pretest": "npm run compile",
    "test": "node --test \"out/test/**/*.test.js\"",
    "package": "vsce package",
    "test:integration": "npm run compile && node out/test/integration/runElectron.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.3"
  }
}
