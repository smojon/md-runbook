# sshd of the md-runbook ops host. It runs as the account ops (not root), so it only logs in as
# ops, and every login runs md-runbook-gate: this file is in the image, out of the account's reach.
Port 2222
HostKey /run/md-runbook-ops/ssh_host_ecdsa_key
PidFile none
UsePAM no

AllowUsers ops
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
# The keys come from a read-only mount (a ConfigMap or a bind mount): see README.md.
AuthorizedKeysFile /etc/md-runbook-ops/keys/authorized_keys
StrictModes no

# Whatever the client asks for, the gate answers: signed runbooks, and unsigned cells only where
# /etc/md-runbook/gate.conf allows them. No forwarding, no terminal, no environment from the client.
# --sshd-force-command: every login runs the gate, whatever the key lines say. The gate takes it
# only with sshd_force_command = yes in a gate.conf the account can't change.
ForceCommand /usr/local/bin/md-runbook-gate --sshd-force-command
DisableForwarding yes
PermitTTY no
PermitUserEnvironment no
# ~/.ssh/rc would run before the gate: the account can write it.
PermitUserRC no
# The gate logs each key's fingerprint.
ExposeAuthInfo yes

# A client gone without a word (a phone out of coverage, behind a relay or load balancer that
# keeps the TCP connection open): its session, and the session's Job, end after 5 minutes
# without an answer, not after the Job's day. The app's SSH library answers these requests.
ClientAliveInterval 60
ClientAliveCountMax 5
# OpenSSH's defaults, without the SHA-1 and 64-bit tag MACs. The app's SSH library uses
# hmac-sha2-256/512 (-etm) or AES-GCM; its key exchange (ECDH P-256/384, DH group 14/16) and
# ciphers (AES-GCM, AES-CTR) are among the defaults, kept.
MACs -hmac-sha1,hmac-sha1-etm@openssh.com,umac-64@openssh.com,umac-64-etm@openssh.com

LogLevel INFO
