# sshd of the md-runbook ops host. It runs as the account ops (not root), so it only logs in as
# ops, and every login runs md-runbook-gate: this file is in the image, out of the account's reach.
Port 2222
HostKey /run/md-runbook-ops/ssh_host_ecdsa_key
PidFile none
UsePAM no

AllowUsers ops
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
# The keys come from a read-only mount (a ConfigMap or a bind mount): see README.md.
AuthorizedKeysFile /etc/md-runbook-ops/keys/authorized_keys
StrictModes no

# Whatever the client asks for, the gate answers: signed runbooks, and unsigned cells only where
# /etc/md-runbook/gate.conf allows them. No forwarding, no terminal, no environment from the client.
ForceCommand /usr/local/bin/md-runbook-gate
DisableForwarding yes
PermitTTY no
PermitUserEnvironment no
# The gate logs each key's fingerprint.
ExposeAuthInfo yes

LogLevel INFO
