#!/bin/bash
# md-runbook-probe: is each endpoint up, seen from here, and when does its certificate expire?
#
#   md-runbook-probe [options] TARGET...       TARGET: host, host:port, [v6]:port, https://host/path,
#                                              tls://host:port (always TLS) or tcp://host:port (never)
#   kubectl get ingress -A -o jsonpath='…' | md-runbook-probe -     targets from stdin, one per line
#
# For each target: the name resolves (DNS), a TCP connection opens, and on TLS ports (443, 6443,
# 8443, 9443, 465, 636, 993, 995, --tls or tls://) the certificate is trusted, is for that name and
# does not expire within --days. One line per target; exit 1 if any check failed, 2 on bad usage.
#
#   --days N        fail when a certificate expires within N days (default 14)
#   --timeout S     seconds per connection (default 5)
#   --ca FILE       trust this CA too, besides the system's CAs
#                   (e.g. /var/run/secrets/kubernetes.io/serviceaccount/ca.crt)
#   --ca-only FILE  trust this CA and no other
#   --no-verify     report expiry without checking trust or the name (self-signed endpoints)
#   --tls | --no-tls  check TLS on every port, or on none (tls:// and tcp:// targets still decide)
#   --ping          also ping (ICMP may be blocked, or not allowed in a container)
#   --format F      text (the lines, default), json (one object per target and line) or
#                   prometheus (metrics in the text exposition format)
#   --label N=V     add the label N="V" to every metric and JSON object (repeatable),
#                   e.g. --label component=proxy
#
# Each check is also an audit event: in md-runbook-gate's log when the gate runs the probe (its
# /etc/md-runbook/gate.conf), else where MD_RUNBOOK_PROBE_LOG says: a file, stderr or syslog.
set -u
export LC_ALL=C

days=14
timeout=5
ca=
ca_only=
verify=1
tls=auto
ping=0
format=text
stdin=0
targets=()
labels=()

usage() {
  sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"
  exit "${1:-2}"
}
while [ $# -gt 0 ]; do
  case $1 in
    --days) days=${2:-}; shift 2 || usage ;;
    --days=*) days=${1#*=}; shift ;;
    --timeout) timeout=${2:-}; shift 2 || usage ;;
    --timeout=*) timeout=${1#*=}; shift ;;
    --ca) ca=${2:-}; shift 2 || usage ;;
    --ca=*) ca=${1#*=}; shift ;;
    --ca-only) ca_only=${2:-}; shift 2 || usage ;;
    --ca-only=*) ca_only=${1#*=}; shift ;;
    --no-verify) verify=0; shift ;;
    --tls) tls=all; shift ;;
    --no-tls) tls=none; shift ;;
    --ping) ping=1; shift ;;
    --format) format=${2:-}; shift 2 || usage ;;
    --format=*) format=${1#*=}; shift ;;
    --label) labels+=("${2:-}"); shift 2 || usage ;;
    --label=*) labels+=("${1#*=}"); shift ;;
    -h | --help) usage 0 ;;
    -) stdin=1; while IFS= read -r l || [ -n "$l" ]; do for t in $l; do targets+=("$t"); done; done; shift ;;
    -*) echo "md-runbook-probe: unknown option $1" >&2; usage ;;
    *) targets+=("$1"); shift ;;
  esac
done
[[ $days =~ ^[0-9]+$ && $timeout =~ ^[0-9]+$ ]] || { echo "md-runbook-probe: --days and --timeout take whole numbers" >&2; exit 2; }
case $format in text | json | prometheus) ;; *) echo "md-runbook-probe: --format is text, json or prometheus" >&2; exit 2 ;; esac
[ -z "$ca" ] || [ -z "$ca_only" ] || { echo "md-runbook-probe: --ca or --ca-only, not both" >&2; exit 2; }
for f in "$ca" "$ca_only"; do
  [ -z "$f" ] || [ -r "$f" ] || { echo "md-runbook-probe: can't read $f" >&2; exit 2; }
done

json_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037')"; }
prom_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

# --label NAME=VALUE: NAME as Prometheus allows it (not target, not __reserved, once), a VALUE
# without control characters; escaped for each format.
prom_labels=
json_labels=
names=" target "
for l in ${labels[@]+"${labels[@]}"}; do
  name=${l%%=*}
  value=${l#*=}
  if [[ $l != *=* || ! $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ || $name == __* || $names == *" $name "* || -z $value ]]; then
    echo "md-runbook-probe: --label takes NAME=VALUE, once per NAME (letters, digits and _, not target): $(printf '%q' "$l")" >&2
    exit 2
  fi
  [[ $value != *[[:cntrl:]]* ]] || { echo "md-runbook-probe: --label $name: no control characters in the value" >&2; exit 2; }
  names="$names$name "
  prom_labels="$prom_labels,$name=$(prom_str "$value")"
  json_labels="$json_labels${json_labels:+,}$(json_str "$name"):$(json_str "$value")"
done

if [ ${#targets[@]} -eq 0 ]; then
  # Nothing to check (e.g. a cluster without Ingresses) is not a failure.
  if [ "$stdin" = 1 ]; then
    if [ "$format" = text ]; then echo "md-runbook-probe: no targets on stdin"; else echo "md-runbook-probe: no targets on stdin" >&2; fi
    exit 0
  fi
  usage
fi

is_tls_port() {
  case $tls in all) return 0 ;; none) return 1 ;; esac
  case $1 in 443 | 6443 | 8443 | 9443 | 465 | 636 | 993 | 995) return 0 ;; esac
  return 1
}

now_ms() { echo $(($(date +%s%N) / 1000000)); }

# --ca adds to the system's CAs: s_client's -CAfile alone would replace them. So the CA file it
# gets is OpenSSL's default bundle (or SSL_CERT_FILE) followed by --ca, with the default folder
# (or SSL_CERT_DIR) as -CApath; through a pipe, as the root filesystem may be read-only. Only
# folders that exist: s_client gives up on a missing one.
system_ca_file=
system_ca_dir=
if [ -n "$ca" ]; then
  ssl_dir=$(openssl version -d 2>/dev/null | sed -n 's/^OPENSSLDIR: "\(.*\)"$/\1/p')
  system_ca_file=${SSL_CERT_FILE:-${ssl_dir:+$ssl_dir/cert.pem}}
  IFS=: read -r -a dirs <<<"${SSL_CERT_DIR:-${ssl_dir:+$ssl_dir/certs}}"
  for d in ${dirs[@]+"${dirs[@]}"}; do
    [ -d "$d" ] && system_ca_dir="$system_ca_dir${system_ca_dir:+:}$d"
  done
fi
ca_bundle() {
  [ -z "$system_ca_file" ] || { cat -- "$system_ca_file" && echo; } 2>/dev/null
  cat -- "$ca"
}

# ---- the audit trail ----
# Each check is an event in md-runbook-gate's log (the ops host's /etc/md-runbook/gate.conf
# names it), next to the gate's own: who (the key the gate saw), from where, the signed run that
# started it (MD_RUNBOOK_GATE_RUN), the target, the result and the certificate. `md-runbook
# audit` lists them. Where the gate runs the probe, only gate.conf decides. Elsewhere (no
# gate.conf, e.g. kubectl exec into a pod) MD_RUNBOOK_PROBE_LOG may name a file (in a container
# /proc/1/fd/1 is its log), stderr or syslog; without it nothing is logged.
log=
log_warned=0
if [ -r /etc/md-runbook/gate.conf ]; then
  log=$(sed -n 's/^[[:space:]]*log[[:space:]]*=[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*$/\1/p' /etc/md-runbook/gate.conf | tail -n 1)
  log=${log:-syslog}
elif [ -n "${MD_RUNBOOK_PROBE_LOG:-}" ]; then
  log=$MD_RUNBOOK_PROBE_LOG
fi
log_event() {
  [ -n "$log" ] || return 0
  local entry client=${SSH_CLIENT:-}
  entry="{\"time\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"account\":$(json_str "$(id -un 2>/dev/null)"),\"who\":$(json_str "${MD_RUNBOOK_GATE_WHO:-}"),\"client\":$(json_str "${client%% *}"),\"event\":\"probe\""
  while [ $# -ge 2 ]; do
    [ -n "$2" ] && entry="$entry,\"$1\":$(json_str "$2")"
    shift 2
  done
  entry="$entry}"
  case $log in
    # --socket-errors: without it, logger says nothing and succeeds where no syslog listens.
    syslog) logger --socket-errors=on -t md-runbook-gate -- "$entry" 2>/dev/null ;;
    stderr) printf '%s\n' "$entry" >&2 ;;
    *) { printf '%s\n' "$entry" >>"$log"; } 2>/dev/null ;;
  esac && return 0
  # Not silently: once per run, on stderr (the output itself stays as it is).
  [ "$log_warned" = 1 ] || echo "md-runbook-probe: can't write the audit log $log: these checks are not logged" >&2
  log_warned=1
}

# ---- output ----
# text: the lines (what Export Report reads). json: an object per target and line. prometheus:
# the metric families, printed at the end; a target listed twice is in them once.
jstr() { if [ -n "$1" ]; then json_str "$1"; else printf null; fi; }
jnum() { printf '%s' "${1:-null}"; }
jbool() { case $1 in 1) printf true ;; 0) printf false ;; *) printf null ;; esac; }
m_ok=
m_reachable=
m_expiry=
m_last_run=
seen=" "
emit() {
  local result=$1 detail=$2 ok=0 l
  [ "$result" = OK ] && ok=1
  case $format in
    text) printf '%-4s  %-40s  %s\n' "$result" "$label" "$detail" ;;
    json)
      printf '{"time":"%s","target":%s,"ok":%s,"address":%s,"reachable":%s,"tcp_ms":%s,"tls":%s,"trusted":%s,"not_after":%s,"days_left":%s,"subject":%s,"issuer":%s,"detail":%s,"labels":{%s}}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(json_str "$label")" "$(jbool "$ok")" "$(jstr "${addr:-}")" "$(jbool "$reachable")" \
        "$(jnum "$ms")" "$(jbool "$use_tls")" "$(jbool "$trusted")" "$(jstr "$c_end")" "$(jnum "$c_left")" \
        "$(jstr "$subject")" "$(jstr "$issuer")" "$(json_str "$detail")" "$json_labels"
      ;;
    prometheus)
      case $seen in *" $label "*) return ;; esac
      seen="$seen$label "
      l="{target=$(prom_str "$label")$prom_labels}"
      m_ok+="md_runbook_probe_ok$l $ok"$'\n'
      m_reachable+="md_runbook_probe_reachable$l $reachable"$'\n'
      [ -z "$c_epoch" ] || m_expiry+="md_runbook_probe_certificate_expiry_timestamp_seconds$l $c_epoch"$'\n'
      m_last_run+="md_runbook_probe_last_run_timestamp_seconds$l $(date +%s)"$'\n'
      ;;
  esac
}
metrics() {
  printf '# HELP md_runbook_probe_ok 1 if every check of the target passed (DNS, TCP, the certificate), else 0.\n# TYPE md_runbook_probe_ok gauge\n%s' "$m_ok"
  printf '# HELP md_runbook_probe_reachable 1 if a TCP connection to the target opened, else 0.\n# TYPE md_runbook_probe_reachable gauge\n%s' "$m_reachable"
  printf '# HELP md_runbook_probe_certificate_expiry_timestamp_seconds When the certificate of the TLS target expires (Unix time).\n# TYPE md_runbook_probe_certificate_expiry_timestamp_seconds gauge\n%s' "$m_expiry"
  printf '# HELP md_runbook_probe_last_run_timestamp_seconds When the target was last checked (Unix time).\n# TYPE md_runbook_probe_last_run_timestamp_seconds gauge\n%s' "$m_last_run"
}

# Host names, IPv4 and (in brackets) IPv6 addresses only: nothing that openssl or ping could read
# as an option, no spaces, no control characters.
HOST_RE='^[A-Za-z0-9]([A-Za-z0-9._-]{0,251}[A-Za-z0-9])?$'
V6_RE='^[0-9A-Fa-f:.]{2,45}(%[A-Za-z0-9._-]{1,32})?$'

failed=0
probe() {
  local target=$1 host port='' rest scheme='' addr='' t0 ms='' out code end left subject='' issuer='' verdict
  local c_sha='' c_end='' c_left='' c_epoch='' reachable=0 use_tls=0 trusted=''
  # The line (or object, or metrics) and the event in the log.
  report() {
    [ "$1" = OK ] || failed=1
    emit "$1" "$2"
    log_event run "${MD_RUNBOOK_GATE_RUN:-}" target "$label" address "${addr:-}" result "$(tr '[:upper:]' '[:lower:]' <<<"$1")" \
      detail "$2" days_left "$c_left" not_after "$c_end" cert_sha256 "$c_sha"
  }
  # https://host:port/path, tls://host:port, tcp://host:port, host:port, [v6]:port, host.
  rest=${target#*://}
  if [ "$rest" != "$target" ]; then
    scheme=${target%%://*}
    case $scheme in http) port=80 ;; tcp) ;; *) port=443 ;; esac
  fi
  rest=${rest%%/*}
  if [[ $rest =~ ^\[(.*)\](:([0-9]+))?$ ]]; then
    host=${BASH_REMATCH[1]}
    port=${BASH_REMATCH[3]:-$port}
  elif [[ $rest =~ ^([^:]+):([0-9]+)$ ]]; then
    host=${BASH_REMATCH[1]}
    port=${BASH_REMATCH[2]}
  else
    host=$rest
  fi
  # tcp:// has no default port.
  [ "$scheme" = tcp ] || port=${port:-443}
  local label="$host:$port"
  [[ $host == *:* ]] && label="[$host]:$port"
  if ! { [[ $host =~ $HOST_RE ]] || { [[ $host == *:* ]] && [[ $host =~ $V6_RE ]]; }; } || ! [[ $port =~ ^[0-9]{1,5}$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    label=$(printf '%s' "$target" | tr -cd '[:alnum:]._:/[]@-' | cut -c1-80)
    report FAIL "not a host name, address or URL"
    return
  fi
  case $scheme in
    tls) use_tls=1 ;;
    tcp) use_tls=0 ;;
    *) is_tls_port "$port" && use_tls=1 ;;
  esac

  addr=$(getent ahosts "$host" 2>/dev/null | awk 'NR == 1 { print $1 }')
  [ -n "$addr" ] || { report FAIL "no address: the name doesn't resolve here (DNS)"; return; }

  local extra=""
  if [ "$ping" = 1 ]; then
    if out=$(ping -n -c 1 -W "$timeout" "$host" 2>&1); then
      extra=", ping $(sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p' <<<"$out" | head -1)ms"
    else
      case $out in *ermission* | *'ot permitted'*) extra=", ping not allowed here" ;; *) extra=", no ping reply" ;; esac
    fi
  fi

  t0=$(now_ms)
  if ! timeout "$timeout" bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$host" "$port" 2>/dev/null; then
    report FAIL "$addr, no TCP connection within ${timeout}s (down, or a firewall)$extra"
    return
  fi
  ms=$(($(now_ms) - t0))
  reachable=1
  if [ "$use_tls" = 0 ]; then
    report OK "$addr, tcp ${ms}ms$extra"
    return
  fi

  local args=(-connect "$label" -servername "$host" -showcerts)
  if [ "$verify" = 1 ]; then
    if [[ $host =~ ^[0-9.]+$ || $host == *:* ]]; then args+=(-verify_ip "$host"); else args+=(-verify_hostname "$host"); fi
  fi
  [ -n "$ca_only" ] && args+=(-CAfile "$ca_only")
  [ -n "$ca" ] && [ -n "$system_ca_dir" ] && args+=(-CApath "$system_ca_dir")
  if [ -n "$ca" ]; then
    out=$(timeout "$timeout" openssl s_client "${args[@]}" -CAfile <(ca_bundle) </dev/null 2>/dev/null)
  else
    out=$(timeout "$timeout" openssl s_client "${args[@]}" </dev/null 2>/dev/null)
  fi
  local cert
  cert=$(sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/{p;/-----END CERTIFICATE-----/q}' <<<"$out")
  [ -n "$cert" ] || { report FAIL "$addr, tcp ${ms}ms, no TLS handshake (not TLS, or refused)$extra"; return; }
  end=$(openssl x509 -noout -enddate <<<"$cert" | cut -d= -f2-)
  subject=$(openssl x509 -noout -subject -nameopt multiline <<<"$cert" | sed -n 's/^ *commonName *= *//p' | head -1)
  issuer=$(openssl x509 -noout -issuer -nameopt multiline <<<"$cert" | sed -n 's/^ *\(commonName\|organizationName\) *= *//p' | head -1)
  c_epoch=$(date -d "$end" +%s)
  left=$(((c_epoch - $(date +%s)) / 86400))
  local when
  when="$(date -u -d "$end" +%Y-%m-%d)"
  c_left=$left
  c_end=$(date -u -d "$end" +%Y-%m-%dT%H:%M:%SZ)
  c_sha=$(openssl x509 -noout -fingerprint -sha256 <<<"$cert" | cut -d= -f2 | tr -d ':' | tr '[:upper:]' '[:lower:]')
  local about="${subject:+CN=$subject, }issuer ${issuer:-?}"
  code=$(sed -n 's/^ *Verify return code: \([0-9]*\) (\(.*\))$/\1 \2/p' <<<"$out" | tail -1)
  if [ "$verify" = 1 ]; then
    if [ "${code%% *}" = 0 ]; then trusted=1; else trusted=0; fi
  fi
  if [ "$left" -lt 0 ]; then
    report FAIL "$addr, tcp ${ms}ms, certificate EXPIRED on $when ($((-left)) days ago), $about$extra"
  elif [ "$verify" = 1 ] && [ "${code%% *}" != 0 ]; then
    report FAIL "$addr, tcp ${ms}ms, certificate not trusted: ${code#* }, expires $when ($left days), $about$extra"
  elif [ "$left" -lt "$days" ]; then
    report FAIL "$addr, tcp ${ms}ms, certificate expires in $left days ($when), under $days, $about$extra"
  else
    verdict=$([ "$verify" = 1 ] && echo "trusted, " || echo "")
    report OK "$addr, tcp ${ms}ms, certificate ${verdict}$left days left ($when), $about$extra"
  fi
}

for t in "${targets[@]}"; do probe "$t"; done
[ "$format" != prometheus ] || metrics
exit "$failed"
