#!/bin/bash
# md-runbook-probe: is each endpoint up, seen from here, and when does its certificate expire?
#
#   md-runbook-probe [options] TARGET...       TARGET: host, host:port, [v6]:port or https://host/path
#   kubectl get ingress -A -o jsonpath='…' | md-runbook-probe -     targets from stdin, one per line
#
# For each target: the name resolves (DNS), a TCP connection opens, and on TLS ports (443, 6443,
# 8443, 9443, 465, 636, 993, 995, or --tls) the certificate is trusted, is for that name and does
# not expire within --days. One line per target; exit 1 if any check failed, 2 on bad usage.
#
#   --days N        fail when a certificate expires within N days (default 14)
#   --timeout S     seconds per connection (default 5)
#   --ca FILE       trust this CA too (e.g. /var/run/secrets/kubernetes.io/serviceaccount/ca.crt)
#   --no-verify     report expiry without checking trust or the name (self-signed endpoints)
#   --tls | --no-tls  check TLS on every port, or on none
#   --ping          also ping (ICMP may be blocked, or not allowed in a container)
set -u
export LC_ALL=C

days=14
timeout=5
ca=
verify=1
tls=auto
ping=0
stdin=0
targets=()

usage() {
  sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"
  exit "${1:-2}"
}
while [ $# -gt 0 ]; do
  case $1 in
    --days) days=${2:-}; shift 2 || usage ;;
    --days=*) days=${1#*=}; shift ;;
    --timeout) timeout=${2:-}; shift 2 || usage ;;
    --timeout=*) timeout=${1#*=}; shift ;;
    --ca) ca=${2:-}; shift 2 || usage ;;
    --ca=*) ca=${1#*=}; shift ;;
    --no-verify) verify=0; shift ;;
    --tls) tls=all; shift ;;
    --no-tls) tls=none; shift ;;
    --ping) ping=1; shift ;;
    -h | --help) usage 0 ;;
    -) stdin=1; while IFS= read -r l || [ -n "$l" ]; do for t in $l; do targets+=("$t"); done; done; shift ;;
    -*) echo "md-runbook-probe: unknown option $1" >&2; usage ;;
    *) targets+=("$1"); shift ;;
  esac
done
[[ $days =~ ^[0-9]+$ && $timeout =~ ^[0-9]+$ ]] || { echo "md-runbook-probe: --days and --timeout take whole numbers" >&2; exit 2; }
[ -z "$ca" ] || [ -r "$ca" ] || { echo "md-runbook-probe: can't read $ca" >&2; exit 2; }
if [ ${#targets[@]} -eq 0 ]; then
  # Nothing to check (e.g. a cluster without Ingresses) is not a failure.
  [ "$stdin" = 1 ] && { echo "md-runbook-probe: no targets on stdin"; exit 0; }
  usage
fi

is_tls_port() {
  case $tls in all) return 0 ;; none) return 1 ;; esac
  case $1 in 443 | 6443 | 8443 | 9443 | 465 | 636 | 993 | 995) return 0 ;; esac
  return 1
}

now_ms() { echo $(($(date +%s%N) / 1000000)); }

# ---- the audit trail ----
# Each check is an event in md-runbook-gate's log (the ops host's /etc/md-runbook/gate.conf
# names it), next to the gate's own: who (the key the gate saw), from where, the signed run that
# started it (MD_RUNBOOK_GATE_RUN), the target, the result and the certificate. `md-runbook
# audit` lists them. Elsewhere (no gate.conf) nothing is logged.
log=
if [ -r /etc/md-runbook/gate.conf ]; then
  log=$(sed -n 's/^[[:space:]]*log[[:space:]]*=[[:space:]]*\(.*[^[:space:]]\)[[:space:]]*$/\1/p' /etc/md-runbook/gate.conf | tail -n 1)
  log=${log:-syslog}
fi
json_str() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037')"; }
log_event() {
  [ -n "$log" ] || return 0
  local entry client=${SSH_CLIENT:-}
  entry="{\"time\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"account\":$(json_str "$(id -un 2>/dev/null)"),\"who\":$(json_str "${MD_RUNBOOK_GATE_WHO:-}"),\"client\":$(json_str "${client%% *}"),\"event\":\"probe\""
  while [ $# -ge 2 ]; do
    [ -n "$2" ] && entry="$entry,\"$1\":$(json_str "$2")"
    shift 2
  done
  entry="$entry}"
  if [ "$log" = syslog ]; then
    logger -t md-runbook-gate -- "$entry" 2>/dev/null || true
  else
    printf '%s\n' "$entry" >>"$log" 2>/dev/null || true
  fi
}

# Host names, IPv4 and (in brackets) IPv6 addresses only: nothing that openssl or ping could read
# as an option, no spaces, no control characters.
HOST_RE='^[A-Za-z0-9]([A-Za-z0-9._-]{0,251}[A-Za-z0-9])?$'
V6_RE='^[0-9A-Fa-f:.]{2,45}(%[A-Za-z0-9._-]{1,32})?$'

failed=0
probe() {
  local target=$1 host port rest addr t0 ms out code end left subject issuer verdict
  local c_sha='' c_end='' c_left=''
  # The line on screen (and in the output block) and the event in the log.
  report() {
    printf '%-4s  %-40s  %s\n' "$1" "$label" "$2"
    [ "$1" = OK ] || failed=1
    log_event run "${MD_RUNBOOK_GATE_RUN:-}" target "$label" address "${addr:-}" result "$(tr '[:upper:]' '[:lower:]' <<<"$1")" \
      detail "$2" days_left "$c_left" not_after "$c_end" cert_sha256 "$c_sha"
  }
  # https://host:port/path, host:port, [v6]:port, host.
  rest=${target#*://}
  [ "$rest" != "$target" ] && case ${target%%://*} in http) port=80 ;; *) port=443 ;; esac
  rest=${rest%%/*}
  if [[ $rest =~ ^\[(.*)\](:([0-9]+))?$ ]]; then
    host=${BASH_REMATCH[1]}
    port=${BASH_REMATCH[3]:-${port:-443}}
  elif [[ $rest =~ ^([^:]+):([0-9]+)$ ]]; then
    host=${BASH_REMATCH[1]}
    port=${BASH_REMATCH[2]}
  else
    host=$rest
    port=${port:-443}
  fi
  local label="$host:$port"
  [[ $host == *:* ]] && label="[$host]:$port"
  if ! { [[ $host =~ $HOST_RE ]] || { [[ $host == *:* ]] && [[ $host =~ $V6_RE ]]; }; } || ! [[ $port =~ ^[0-9]{1,5}$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    label=$(printf '%s' "$target" | tr -cd '[:alnum:]._:/[]@-' | cut -c1-80)
    report FAIL "not a host name, address or URL"
    return
  fi

  addr=$(getent ahosts "$host" 2>/dev/null | awk 'NR == 1 { print $1 }')
  [ -n "$addr" ] || { report FAIL "no address: the name doesn't resolve here (DNS)"; return; }

  local extra=""
  if [ "$ping" = 1 ]; then
    if out=$(ping -n -c 1 -W "$timeout" "$host" 2>&1); then
      extra=", ping $(sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p' <<<"$out" | head -1)ms"
    else
      case $out in *ermission* | *'ot permitted'*) extra=", ping not allowed here" ;; *) extra=", no ping reply" ;; esac
    fi
  fi

  t0=$(now_ms)
  if ! timeout "$timeout" bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$host" "$port" 2>/dev/null; then
    report FAIL "$addr, no TCP connection within ${timeout}s (down, or a firewall)$extra"
    return
  fi
  ms=$(($(now_ms) - t0))
  if ! is_tls_port "$port"; then
    report OK "$addr, tcp ${ms}ms$extra"
    return
  fi

  local args=(-connect "$label" -servername "$host" -showcerts)
  if [ "$verify" = 1 ]; then
    if [[ $host =~ ^[0-9.]+$ || $host == *:* ]]; then args+=(-verify_ip "$host"); else args+=(-verify_hostname "$host"); fi
  fi
  [ -n "$ca" ] && args+=(-CAfile "$ca")
  out=$(timeout "$timeout" openssl s_client "${args[@]}" </dev/null 2>/dev/null)
  local cert
  cert=$(sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/{p;/-----END CERTIFICATE-----/q}' <<<"$out")
  [ -n "$cert" ] || { report FAIL "$addr, tcp ${ms}ms, no TLS handshake (not TLS, or refused)$extra"; return; }
  end=$(openssl x509 -noout -enddate <<<"$cert" | cut -d= -f2-)
  subject=$(openssl x509 -noout -subject -nameopt multiline <<<"$cert" | sed -n 's/^ *commonName *= *//p' | head -1)
  issuer=$(openssl x509 -noout -issuer -nameopt multiline <<<"$cert" | sed -n 's/^ *\(commonName\|organizationName\) *= *//p' | head -1)
  left=$((($(date -d "$end" +%s) - $(date +%s)) / 86400))
  local when
  when="$(date -u -d "$end" +%Y-%m-%d)"
  c_left=$left
  c_end=$(date -u -d "$end" +%Y-%m-%dT%H:%M:%SZ)
  c_sha=$(openssl x509 -noout -fingerprint -sha256 <<<"$cert" | cut -d= -f2 | tr -d ':' | tr '[:upper:]' '[:lower:]')
  local about="${subject:+CN=$subject, }issuer ${issuer:-?}"
  code=$(sed -n 's/^ *Verify return code: \([0-9]*\) (\(.*\))$/\1 \2/p' <<<"$out" | tail -1)
  if [ "$left" -lt 0 ]; then
    report FAIL "$addr, tcp ${ms}ms, certificate EXPIRED on $when ($((-left)) days ago), $about$extra"
  elif [ "$verify" = 1 ] && [ "${code%% *}" != 0 ]; then
    report FAIL "$addr, tcp ${ms}ms, certificate not trusted: ${code#* }, expires $when ($left days), $about$extra"
  elif [ "$left" -lt "$days" ]; then
    report FAIL "$addr, tcp ${ms}ms, certificate expires in $left days ($when), under $days, $about$extra"
  else
    verdict=$([ "$verify" = 1 ] && echo "trusted, " || echo "")
    report OK "$addr, tcp ${ms}ms, certificate ${verdict}$left days left ($when), $about$extra"
  fi
}

for t in "${targets[@]}"; do probe "$t"; done
exit "$failed"
