#!/bin/sh
# md-runbook-gate: the only program an SSH key restricted with
#   restrict,command="/usr/local/bin/md-runbook-gate" ssh-ed25519 AAAA... alice@support
# may start. It runs the cells of runbooks signed by a key in allowed_signers (and, if this
# server or key allows it, unsigned cells), in one persistent shell per connection, and logs
# every request. See README.md next to this file and docs/features/signed-runbooks.md.
#
# Options (in the authorized_keys command): --config=FILE (default /etc/md-runbook/gate.conf),
# --unsigned=allow|refuse and --scopes=a,b (override the config for this key), --who=NAME (the
# name logged for this key; default: the key's fingerprint, with ExposeAuthInfo yes in sshd).
# --sshd-force-command (sshd_config's ForceCommand only) and sshd_force_command = yes in a
# gate.conf the account can't change go together: one without the other stops the gate.
#
# Each signed runbook runs in a shell of its own (bash --noprofile --norc, else sh) with the PATH
# and locale of gate.conf: nothing from the account's profile, the client's locale or another
# runbook. The cells of one runbook share that shell, as in a plain session, also after a call
# into another runbook. A signed block is trusted code: it can read what its shell gets next and
# answer for later runs (see README.md, Trust). Other processes of the account can reach a
# session's shells through /proc: the account must be used by the gate alone, and with
# kill_leftovers = yes the gate ends the account's processes that outlived their session.
#
# The client (the md-runbook app) speaks a line protocol on stdin; replies end with the same
# end-of-cell marker as a plain shell session (\036__MDRB_<id>__ <exit>, on stdout and stderr).
#   : mdrb-gate-hello ID; ...           -> banner \036__MDRB_GATE__ PROTOCOL unsigned=allow|refuse (PROTOCOL: GATE_PROTOCOL below), marker with the session number (what a stop request names)
#   called ID HASH N                  -> (protocol 2) the next load is the runbook called by call N of the
#                                        runbook with manifest sha256 HASH: logged with that load (what the
#                                        app says, for the audit; it grants nothing)
#   note ID KEY VALUE [KEY VALUE ...] -> (protocol 3) base64 values; KEY is ALERT (required), ALERT_FINGERPRINT
#                                        or ALERT_STARTS_AT: the next load answers that alert (the run's alert
#                                        link): logged with that load (what the app says, for the audit; it
#                                        grants nothing and runs nothing)
#   load ID MANIFEST SIGNATURE        -> base64; checks the signature and policy; \036__MDRB_SIGNED__ PRINCIPAL HASH
#   param ID NAME VALUE               -> base64 value, checked against the manifest's pattern
#   run ID CELL | step ID CELL K      -> runs a signed cell, or its K-th command (0-based)
#   raw ID TEXT                       -> base64 shell text, only where unsigned cells are allowed
#   context ID                        -> runs `kubectl config current-context` (the kube-context guard)
# A second connection whose command is `pkill -TERM|-KILL -P N 2>/dev/null; true` stops the
# running cell of session N (the number its hello answered; what the app sends to cancel).

set -u
# No filename expansion anywhere (principals such as *@example.net, scopes).
set -f
umask 077
# The gate's own environment: nothing that changes how the programs it starts (ssh-keygen, curl,
# awk, perl) load code, read files or connect. sshd passes what a key line's environment= and
# ~/.ssh/environment set (with PermitUserEnvironment yes), and the names AcceptEnv lets the client
# send (security review round 4). The gate refuses environment= and ~/.ssh/environment below;
# this is for the rest. (The blocks' shell gets the names in cells_env_names only.)
_exported=$(export -p)
while IFS= read -r _l; do
  case $_l in
    'export '*) _l=${_l#export } ;;
    'declare -x '*) _l=${_l#declare -x } ;;
    *) continue ;;
  esac
  _n=${_l%%=*}
  case $_n in '' | [0-9]* | *[!A-Za-z0-9_]*) continue ;; esac
  case $_n in
    LD_* | DYLD_* | BASH_ENV | ENV | CDPATH | GLOBIGNORE | SHELLOPTS | BASHOPTS | PS4 | \
      *_proxy | *_PROXY | CURL_* | SSL_* | OPENSSL_* | GCONV_PATH | LOCPATH | NLSPATH | GLIBC_TUNABLES | MALLOC_* | \
      HOSTALIASES | RES_OPTIONS | LOCALDOMAIN | AWKPATH | AWKLIBPATH | PERL5* | PERLLIB | PYTHON* | NODE_OPTIONS | \
      SSH_SK_PROVIDER | SSH_ASKPASS | SSH_ASKPASS_REQUIRE | SSH_AUTH_SOCK | XDG_CONFIG_HOME | KUBECONFIG | LANG | LANGUAGE | LC_*)
      unset "$_n" 2>/dev/null || true
      ;;
  esac
done <<EOF
$_exported
EOF
unset _exported _l _n
# The gate's own checks (grep -E on parameter patterns, sed, awk) in the C locale: sshd may pass
# the client's LANG and LC_* (AcceptEnv), which would change what a pattern matches. The cells'
# shell gets gate.conf's locale instead (security review, 2026-11-16).
LC_ALL=C
export LC_ALL
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin${PATH:+:$PATH}
GATE_PROTOCOL=3
REFUSED=126
nl='
'

say() { printf 'md-runbook-gate: %s\n' "$*" >&2; }
fatal() {
  say "$*"
  exit 2
}

# trim TEXT: without leading and trailing blanks, in $tv (no program: forks are slow on some systems).
# (Blanks spelled out: dash reads no [[:space:]] in a pattern.)
blanks=" $(printf '\t\r')"
trim() {
  tv=$1
  while :; do case $tv in ["$blanks"]*) tv=${tv#?} ;; *) break ;; esac; done
  while :; do case $tv in *["$blanks"]) tv=${tv%?} ;; *) break ;; esac; done
}
# A whole number of MiB (0 to 9999999, no leading zeros).
is_mib() {
  case $1 in '' | *[!0-9]* | 0?*) return 1 ;; esac
  [ ${#1} -le 7 ]
}

# ---- options and configuration ----

config=/etc/md-runbook/gate.conf
config_named=
key_unsigned=
key_scopes=
key_signers=
who=
sshd_force_command=
cli_force_command=
for a in "$@"; do
  case $a in
    --config=*)
      config=${a#*=}
      config_named=1
      ;;
    --unsigned=allow | --unsigned=refuse) key_unsigned=${a#*=} ;;
    --scopes=*)
      key_scopes=$(printf '%s' "${a#*=}" | tr ',' ' ')
      trim "$key_scopes"
      # Empty is not "every scope": fail closed (security review, 2026-11-16).
      [ -n "$tv" ] || fatal "--scopes= is empty: name the scopes this key may run, or leave the option out"
      ;;
    --signers=*) key_signers=${a#*=} ;;
    --who=*) who=${a#*=} ;;
    # Only a statement: gate.conf decides (security review round 3, 2026-11-16).
    --sshd-force-command) cli_force_command=1 ;;
    *) fatal "unknown option $a" ;;
  esac
done

unsigned=refuse
scopes='*'
allowed_signers=/etc/md-runbook/allowed_signers
revoked=
floors=
signers=1
log=syslog
report_to=
report_token_file=
# The cells' PATH: root-owned folders only. Never the account's profile (a file the account can
# write) and never the client's.
cells_path=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
cells_locale=auto
# The cells' KUBECONFIG (else kubectl's default, ~/.kube/config): never the account's environment.
cells_kubeconfig=
# no: don't check the account's login shell (tests on a server whose accounts have bash).
login_shell_check=yes
# The files sshd reads this account's keys from (AuthorizedKeysFile): %h is the home folder, %u
# the account, %U its uid, %% a %; a relative path is in the home folder.
authorized_keys='%h/.ssh/authorized_keys %h/.ssh/authorized_keys2'
# yes: at the start and end of each session, end the account's processes that belong to no live
# session (Linux; see sweep_leftovers). For accounts used by the gate alone.
kill_leftovers=no
# yes: run without a way to end a shell's process group (no setsid, no perl): background programs
# of a block may then outlive their session.
allow_no_group_kill=no
# The gate's own processes (not the blocks): at most this many MiB of address space; 0 for none.
memory_limit=512
# A --config= that isn't there is an error, not the built-in defaults (security review, 2026-11-16).
[ -z "$config_named" ] || [ -e "$config" ] || fatal "no config $config (--config=)"
if [ -e "$config" ]; then
  [ -r "$config" ] || fatal "can't read $config"
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    case $line in *=*) ;; *) continue ;; esac
    trim "${line%%=*}"
    k=$tv
    trim "${line#*=}"
    v=$tv
    case $k in
      unsigned) unsigned=$v ;;
      scopes) scopes=$v ;;
      allowed_signers) allowed_signers=$v ;;
      revoked) revoked=$v ;;
      floors) floors=$v ;;
      signers) signers=$v ;;
      log) log=$v ;;
      report_to) report_to=$v ;;
      report_token_file) report_token_file=$v ;;
      path) cells_path=$v ;;
      locale) cells_locale=$v ;;
      kubeconfig) cells_kubeconfig=$v ;;
      login_shell_check)
        case $v in
          yes | no) login_shell_check=$v ;;
          *) fatal "login_shell_check = $v: expected yes or no" ;;
        esac
        ;;
      authorized_keys) authorized_keys=$v ;;
      kill_leftovers | allow_no_group_kill)
        case $v in yes | no) ;; *) fatal "$k = $v: expected yes or no" ;; esac
        if [ "$k" = kill_leftovers ]; then kill_leftovers=$v; else allow_no_group_kill=$v; fi
        ;;
      memory_limit)
        is_mib "$v" || fatal "memory_limit = $v: expected a number of MiB (0 for none)"
        memory_limit=$v
        ;;
      sshd_force_command)
        case $v in
          yes) sshd_force_command=yes ;;
          no) ;;
          *) fatal "sshd_force_command = $v: expected yes or no" ;;
        esac
        ;;
      *) fatal "$config: unknown setting \"$k\"" ;;
    esac
  done <"$config"
fi
[ -n "$key_unsigned" ] && unsigned=$key_unsigned
case $unsigned in allow | refuse) ;; *) fatal "unsigned = $unsigned: expected allow or refuse" ;; esac
[ -n "$scopes" ] || fatal "scopes = is empty in $config: name the scopes, or * for any"
[ -n "$key_signers" ] && signers=$key_signers
case $signers in [1-5]) ;; *) fatal "signers = $signers: expected 1 to 5" ;; esac
if [ "$log" != syslog ]; then
  touch "$log" 2>/dev/null && [ -w "$log" ] || fatal "can't write the log $log"
fi
# Absolute folders only: an empty entry or a relative one would be the cell's working folder.
case ":$cells_path:" in
  :: | *::* | *:[!/]*) fatal "path = $cells_path: expected absolute folders separated by :" ;;
esac
case $cells_locale in
  auto)
    # C.UTF-8 where the system has it (glibc lists it as C.utf8), else C.
    if locale -a 2>/dev/null | grep -Eqix 'c\.utf-?8'; then cells_locale=C.UTF-8; else cells_locale=C; fi
    ;;
  '' | *[!A-Za-z0-9._@-]*) fatal "locale = $cells_locale: expected a locale name such as C.UTF-8, or auto" ;;
esac
if [ -n "$cells_kubeconfig" ]; then
  case ":$cells_kubeconfig:" in
    *::* | *:[!/]*) fatal "kubeconfig = $cells_kubeconfig: expected absolute files separated by :" ;;
  esac
fi
# Run reports (report_to): optional, and never in a run's way. A bad address is logged at the
# start of each session and nothing is sent; the runs go on.
report_on=
report_problem=
if [ -n "$report_to" ]; then
  if printf '%s\n' "$report_to" | grep -Eqx 'https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[A-Za-z0-9._~/%+=-]*)?|http://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]{1,5})?(/[A-Za-z0-9._~/%+=-]*)?'; then
    report_on=1
  else
    report_problem="report_to must be an https address without user name or query (http only for localhost)"
  fi
fi

account=$(id -un 2>/dev/null || echo "?")
uid=$(id -u 2>/dev/null || echo "?")

# can_change FILE: the account could change FILE: it can write it or its folder, or it owns it
# (and so could chmod it).
can_change() {
  case $1 in */*) _d=${1%/*} ;; *) _d=. ;; esac
  [ -w "$1" ] || [ -w "${_d:-/}" ] || [ "$(ls -ldnL -- "$1" 2>/dev/null | awk '{ print $3 }')" = "$uid" ]
}
# sshd_force_command switches off the check of the key lines (below), so it counts only from a
# gate.conf out of the account's reach. A key line can't say it (security review round 3). And
# only together with --sshd-force-command, which only sshd_config's ForceCommand line has: a
# gate.conf shared with key lines doesn't switch their check off (security review round 4).
[ -z "$cli_force_command" ] || [ -n "$sshd_force_command" ] ||
  fatal "--sshd-force-command needs sshd_force_command = yes in $config"
[ -z "$sshd_force_command" ] || [ -n "$cli_force_command" ] ||
  fatal "sshd_force_command = yes in $config needs --sshd-force-command on sshd_config's ForceCommand line"
if [ -n "$sshd_force_command" ] && can_change "$config"; then
  fatal "sshd_force_command = yes in $config, a file this account can change: make it and its folder root-owned and not writable by the account"
fi
client=${SSH_CLIENT:-}
client=${client%% *}
if [ -z "$who" ] && [ -n "${SSH_USER_AUTH:-}" ] && [ -r "$SSH_USER_AUTH" ]; then
  who=$(sed -n 's/^publickey //p' "$SSH_USER_AUTH" | head -n 1 | ssh-keygen -lf - 2>/dev/null | awk '{ print $2 }')
fi

# ---- helpers ----

# json_v TEXT: TEXT as a JSON string, in $jv. Plain printable ASCII needs no program (forks are
# slow on some systems); anything else goes through sed and tr.
json_v() {
  case $1 in
    *[\\\"]* | *[!\ -~]*) jv="\"$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\037')\"" ;;
    *) jv="\"$1\"" ;;
  esac
}
json_str() {
  json_v "$1"
  printf '%s' "$jv"
}

# log_event KEY VALUE ...: one JSON line (syslog tag md-runbook-gate, or the log file).
log_event() {
  entry="{\"time\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\""
  json_v "$account"
  entry="$entry,\"account\":$jv"
  json_v "$who"
  entry="$entry,\"who\":$jv"
  json_v "$client"
  entry="$entry,\"client\":$jv"
  while [ $# -ge 2 ]; do
    json_v "$2"
    entry="$entry,\"$1\":$jv"
    shift 2
  done
  entry="$entry}"
  if [ "$log" = syslog ]; then
    logger -t md-runbook-gate -- "$entry" 2>/dev/null || true
  else
    printf '%s\n' "$entry" >>"$log" 2>/dev/null || true
  fi
}

# POSIX single quotes.
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

if printf 'eA==' | base64 -d >/dev/null 2>&1; then
  b64d() { base64 -d; }
else
  b64d() { base64 -D; }
fi

is_b64() { case $1 in *[!A-Za-z0-9+/=]*) return 1 ;; esac; }
is_id() {
  case $1 in '' | *[!0-9a-f]*) return 1 ;; esac
  [ ${#1} -le 64 ]
}
is_num() {
  # No leading zeros: $((08 + 1)) is octal (or an error) in sh.
  case $1 in '' | *[!0-9]* | 0?*) return 1 ;; esac
  [ ${#1} -le 6 ]
}
is_var() { case $1 in '' | [0-9]* | *[!A-Za-z0-9_]*) return 1 ;; esac; }
# Names a parameter or env.* value may not set: they change how the shell or the programs it
# starts read the signed code, or where they connect (also refused when signing: core's
# RESERVED_VARS and RESERVED_VAR_PREFIXES, the same list; a test compares them). Not
# KUBECONFIG: env.KUBECONFIG picks the cluster, and is signed.
is_reserved() {
  case $1 in
    PATH | IFS | ENV | BASH_ENV | CDPATH | GLOBIGNORE | HOME | SHELL | SHELLOPTS | BASHOPTS | PS1 | PS2 | PS3 | PS4 | \
      PROMPT_COMMAND | PWD | OLDPWD | TMPDIR | BASH_COMPAT | BASH_XTRACEFD | HISTFILE | \
      LANG | LANGUAGE | GCONV_PATH | LOCPATH | GLIBC_TUNABLES | \
      NODE_OPTIONS | PYTHONPATH | PYTHONSTARTUP | PYTHONHOME | PERL5OPT | PERL5LIB | RUBYOPT | RUBYLIB | JAVA_TOOL_OPTIONS | _JAVA_OPTIONS | \
      GIT_SSH_COMMAND | GIT_SSH | GIT_CONFIG | GIT_CONFIG_GLOBAL | GIT_CONFIG_SYSTEM | GIT_CONFIG_COUNT | GIT_CONFIG_PARAMETERS | \
      http_proxy | https_proxy | all_proxy | no_proxy | HTTP_PROXY | HTTPS_PROXY | ALL_PROXY | NO_PROXY | CURL_HOME | CURL_CA_BUNDLE | \
      XDG_CONFIG_HOME | SSL_CERT_FILE | SSL_CERT_DIR | NODE_EXTRA_CA_CERTS | REQUESTS_CA_BUNDLE | \
      GIT_EXEC_PATH | GIT_PROXY_COMMAND | GIT_ASKPASS | SSH_ASKPASS | GIT_EXTERNAL_DIFF | JDK_JAVA_OPTIONS | OPENSSL_CONF | \
      LUA_INIT | PERLLIB | PHPRC | AWS_CONFIG_FILE | AWS_SHARED_CREDENTIALS_FILE | HOSTALIASES | PAGER | LESSOPEN | LESSCLOSE | \
      KUBECTL_EXTERNAL_DIFF | ftp_proxy | FTP_PROXY | EDITOR | VISUAL | BROWSER | \
      LC_* | LD_* | DYLD_* | BASH_FUNC_* | __mdrb_* | MD_RUNBOOK_GATE_* | GIT_CONFIG_KEY_* | GIT_CONFIG_VALUE_*) return 0 ;;
  esac
  return 1
}
# The gate's own environment the cells' shell gets: these names only (security review round 3).
# Not what sshd's environment= or ~/.ssh/environment may add (proxies, NODE_OPTIONS, KUBECONFIG).
# SHELL, PATH, LANG and KUBECONFIG are the gate's (gate.conf).
cells_env_names='HOME USER LOGNAME SSH_CLIENT SSH_CONNECTION SSH_TTY TERM TZ TMPDIR'

# The command that prints the sha256 of stdin (hex, then a space): absolute, so the cells' shell
# runs this one whatever its PATH.
if command -v sha256sum >/dev/null 2>&1; then
  sha_bin=$(command -v sha256sum)
  sha_args=
elif command -v shasum >/dev/null 2>&1; then
  sha_bin=$(command -v shasum)
  sha_args='-a 256'
else
  sha_bin=$(command -v openssl)
  sha_args='dgst -sha256 -r'
fi
# sha256 of stdin, hex.
sha256_in() {
  # shellcheck disable=SC2086
  "$sha_bin" $sha_args | cut -d ' ' -f 1
}
sha256() { sha256_in <"$1"; }

# write_new FILE: stdin to FILE, which must not exist yet (noclobber: never through a link a
# cell planted at that name).
write_new() { (set -C && cat >"$1") 2>/dev/null; }
# A new file name in the work folder, not yet created (mktemp's name, the file removed again).
new_name() {
  _f=$(mktemp "$work/$1.XXXXXX") && rm -f "$_f" && printf '%s\n' "$_f"
}

# The first executable NAME in the cells' PATH.
in_cells_path() {
  _ifs=$IFS
  IFS=:
  for _d in $cells_path; do
    if [ -f "$_d/$1" ] && [ -x "$_d/$1" ]; then
      IFS=$_ifs
      printf '%s\n' "$_d/$1"
      return 0
    fi
  done
  IFS=$_ifs
  return 1
}

marker() {
  printf '\036__MDRB_%s__ %s\n' "$1" "$2" >&2
  printf '\036__MDRB_%s__ %s\n' "$1" "$2"
}

# refuse ID REASON: the reason on stderr, logged, and exit 126 as the request's result.
refuse() {
  rid=$1
  shift
  say "$*"
  log_event event refused id "$rid" reason "$*"
  marker "$rid" "$REFUSED"
}

# Does a scope list (space-separated, or *) contain $2?
has_scope() {
  [ "$1" = '*' ] && return 0
  for s in $1; do [ "$s" = "$2" ] && return 0; done
  return 1
}

state="${HOME:-/tmp}/.md-runbook-gate"
mkdir -p "$state/pids" 2>/dev/null && chmod 700 "$state" || fatal "can't create $state"

# ---- stopping a running cell (a second connection) ----

# The app sends the number the session's hello answered, as it sends a plain shell's pid. Here
# it is the session's own random number: only the client of that session knows it, so no other
# session (another key of this account) can stop its cells. $state/pids has, under the number's
# sha256, the pid of the session's current shell. The signal goes to every process under that
# shell (a cell's programs and theirs), never to the shell itself (security review, 2026-11-16).
is_pid() {
  case $1 in '' | *[!0-9]* | 0*) return 1 ;; esac
  [ ${#1} -le 10 ]
}
# The pids of every process under $1 (pgrep -P, on Linux and macOS), parents first.
descendants() {
  for _c in $(pgrep -P "$1" 2>/dev/null); do
    is_pid "$_c" || continue
    printf '%s\n' "$_c"
    descendants "$_c"
  done
}
cmd=${SSH_ORIGINAL_COMMAND:-}
case $cmd in
  'pkill -TERM -P '*' 2>/dev/null; true' | 'pkill -KILL -P '*' 2>/dev/null; true')
    sig=${cmd#pkill -}
    sig=${sig%% *}
    n=${cmd#pkill -"$sig" -P }
    n=${n%% *}
    case $n in '' | *[!0-9]*) fatal "bad stop request" ;; esac
    [ ${#n} -le 20 ] || fatal "bad stop request"
    key=$(printf '%s' "$n" | sha256_in)
    [ -f "$state/pids/$key" ] || fatal "no md-runbook session $n"
    shell_pid=$(head -n 1 "$state/pids/$key")
    is_pid "$shell_pid" || fatal "no md-runbook session $n"
    log_event event stop shell "$shell_pid" signal "$sig"
    # Listed first, then signalled: a program stopped first can't hide its children from the list.
    procs=$(descendants "$shell_pid")
    # shellcheck disable=SC2086
    [ -n "$procs" ] && kill -"$sig" $procs 2>/dev/null
    exit 0
    ;;
esac


# authorized_keys as paths: the tokens sshd expands in AuthorizedKeysFile (%h, %u, %U, %%), and
# relative paths. Any other token is an error: a file the gate didn't read could let a key in.
keys_files=
for f in $authorized_keys; do
  _p=
  while :; do
    case $f in
      *%*) ;;
      *) break ;;
    esac
    _p=$_p${f%%\%*}
    f=${f#*%}
    case $f in
      h*) _p=$_p${HOME:-} ;;
      u*) _p=$_p$account ;;
      U*) _p=$_p$uid ;;
      %*) _p=$_p% ;;
      *) fatal "authorized_keys = $authorized_keys: unknown token %${f%"${f#?}"} (sshd expands %h, %u, %U and %%)" ;;
    esac
    f=${f#?}
  done
  f=$_p$f
  case $f in /*) ;; *) f=${HOME:-}/$f ;; esac
  keys_files="${keys_files:+$keys_files }$f"
done
authorized_keys=$keys_files

# ---- all signed or none: the account's keys ----
# The gate's word ("signed, verified") means nothing if another key of the account runs a shell,
# or allows unsigned blocks: those can change what signed blocks find. So each session reads the
# key lines sshd reads for this account and accepts one of two kinds (security review,
# 2026-11-16):
#   signed          every line runs this gate, none allows unsigned blocks: run reports go out;
#   unsigned trial  every line allows unsigned blocks: blocks run, run reports don't go out.
# Anything else (a line without the gate, a mix, a file it can't read) stops here. What it can't
# see: AuthorizedKeysCommand, certificates' principals, passwords, other programs of the account.

# conf_unsigned FILE: the `unsigned` of a gate.conf (the last one, as the gate reads it).
conf_unsigned() {
  awk '{ sub(/#.*/, ""); sub(/\r$/, "") } /=/ {
    k = $0; sub(/=.*/, "", k); gsub(/[ \t]/, "", k)
    if (k == "unsigned") { v = $0; sub(/^[^=]*=/, "", v); gsub(/^[ \t]+|[ \t]+$/, "", v); u = v }
  } END { print (u == "" ? "refuse" : u) }' "$1"
}

# keys_parse FILE: "LINE<TAB>KIND<TAB>OPEN<TAB>ENV<TAB>COMMAND" per key line (comments and blank
# lines skipped). KIND: cmd (a command= option), nocmd, bad (an open quote, two command= options).
# OPEN: - when the line has restrict and turns nothing on again; else the options to change,
# comma-separated. (Not the five no-* options instead: sshd's tunnel check looks for restrict
# itself; security review round 4.) ENV: environment when the line sets one, else -.
# Options as sshd reads them: comma-separated up to the first blank outside quotes, \" in quotes
# a quote.
keys_parse() {
  awk '
    { sub(/\r$/, "") }
    /^[ \t]*$/ || /^[ \t]*#/ { next }
    {
      s = $0; sub(/^[ \t]+/, "", s)
      if (s ~ /^(ssh-|ecdsa-|sk-)/) { print NR "\tnocmd\trestrict\t-\t"; next }
      n = length(s); i = 1; inq = 0; cur = ""; cmd = ""; ncmd = 0
      split("", seen); again = ""
      while (i <= n) {
        c = substr(s, i, 1)
        if (inq) {
          if (c == "\\" && substr(s, i + 1, 1) == "\"") { cur = cur "\""; i += 2; continue }
          if (c == "\"") inq = 0; else cur = cur c
          i++
          continue
        }
        if (c == "\"") { inq = 1; i++; continue }
        if (c == "," || c == " " || c == "\t") {
          name = tolower(cur); sub(/=.*/, "", name)
          if (name == "command") { v = cur; sub(/^[^=]*=/, "", v); cmd = v; ncmd++ }
          seen[name] = 1
          # What turns on again what restrict turns off.
          if (name ~ /^(port-forwarding|permitopen|permitlisten|pty|user-rc|x11-forwarding|agent-forwarding)$/) again = again (again == "" ? "" : ",") name
          cur = ""
          if (c != ",") break
          i++
          continue
        }
        cur = cur c
        i++
      }
      if (inq || ncmd > 1) { print NR "\tbad\t-\t-\t"; next }
      open = again
      if (!("restrict" in seen)) open = "restrict" (open == "" ? "" : "," open)
      print NR "\t" (ncmd ? "cmd" : "nocmd") "\t" (open == "" ? "-" : open) "\t" (("environment" in seen) ? "environment" : "-") "\t" cmd
    }' "$1"
}

# line_unsigned COMMAND: allow or refuse, what a key line whose command= is COMMAND gets; fails
# when COMMAND is not this gate with its own options only (nothing a shell would read more in).
# cmd_words TEXT: TEXT read as a simple sh word list, one word per line: blanks between words,
# '…' and "…" quotes, nothing a shell would expand or run ($, `, \, ;, |, & and the like): else
# it fails.
cmd_words() {
  printf '%s\n' "$1" | awk '
    {
      s = $0; n = length(s); i = 1; w = ""; inw = 0
      while (i <= n) {
        c = substr(s, i, 1)
        if (c == " " || c == "\t") { if (inw) print w; w = ""; inw = 0; i++; continue }
        if (c == "\047" || c == "\"") {
          j = index(substr(s, i + 1), c)
          if (j == 0) exit 1
          t = substr(s, i + 1, j - 1)
          if (c == "\"" && t ~ /[$`\\]/) exit 1
          w = w t; inw = 1; i += j + 1
          continue
        }
        if (c !~ /[A-Za-z0-9._\/@:,+=%-]/) exit 1
        w = w c; inw = 1; i++
      }
      if (inw) print w
    }'
}

line_unsigned() {
  # The command as sh reads it (security review round 3: exec and quoted values are fine).
  _w=$(cmd_words "$1") || return 1
  set --
  while IFS= read -r _x; do
    set -- "$@" "$_x"
  done <<EOF
$_w
EOF
  [ "${1:-}" = exec ] && shift
  case ${1:-} in sh | /bin/sh | /usr/bin/sh | dash | /bin/dash | /usr/bin/dash | bash | /bin/bash | /usr/bin/bash) shift ;; esac
  [ $# -ge 1 ] || return 1
  _g=$1
  shift
  case $_g in *[!A-Za-z0-9._/:+-]*) return 1 ;; */md-runbook-gate | md-runbook-gate) ;; *) return 1 ;; esac
  case $_g in */*) ;; *) _g=$(command -v "$_g") || return 1 ;; esac
  # The same script as this one (a copy the account could change would check nothing): the same
  # path, or the same file name in the same folder once links are resolved.
  [ "$_g" = "$0" ] || { [ -n "$gate_phys" ] && [ "$(phys "$_g")" = "$gate_phys" ]; } || return 1
  _u=
  _c=/etc/md-runbook/gate.conf
  _cset=
  # --sshd-force-command is for sshd_config's ForceCommand, never a key line.
  for _a in "$@"; do
    case $_a in
      --unsigned=allow | --unsigned=refuse) _u=${_a#*=} ;;
      --config=?*)
        _c=${_a#*=}
        _cset=1
        ;;
      --scopes=*[!A-Za-z0-9._/@:,+-]*) return 1 ;;
      --scopes=?* | --signers=[1-5] | --who=?*) ;;
      *) return 1 ;;
    esac
  done
  # The config a key line runs with decides its policy and signers: never one the account could
  # change, as for sshd_force_command (security review round 4). Exit 2, with the file.
  if [ -e "$_c" ] && can_change "$_c"; then
    printf '%s\n' "$_c"
    return 2
  fi
  if [ -z "$_u" ]; then
    if [ -r "$_c" ]; then
      _u=$(conf_unsigned "$_c")
    elif [ -n "$_cset" ] || [ -e "$_c" ]; then
      return 1
    else
      _u=refuse
    fi
  fi
  case $_u in allow | refuse) printf '%s\n' "$_u" ;; *) return 1 ;; esac
}

# phys FILE: FILE with its folder's links resolved.
phys() {
  case $1 in */*) ;; *) return 1 ;; esac
  _d=$(cd -P -- "${1%/*}/" 2>/dev/null && pwd -P) && printf '%s/%s\n' "${_d%/}" "${1##*/}"
}
gate_phys=$(phys "$0") || gate_phys=

account_fatal() {
  log_event event account-check status refused reason "$(printf '%s' "$*" | tr '\n' ' ')"
  fatal "$*"
}

if [ -n "$sshd_force_command" ]; then
  # sshd runs this gate for every login of the account, whatever the key lines say.
  account_kind=$unsigned
else
  problems=
  allow_ids=
  refuse_ids=
  nlines=0
  nfiles=0
  for f in $authorized_keys; do
    nfiles=$((nfiles + 1))
  done
  tab=$(printf '\t')
  for f in $authorized_keys; do
    # A file that doesn't exist lets no key in.
    [ -e "$f" ] || [ -L "$f" ] || continue
    [ -r "$f" ] || account_fatal "can't read $f (authorized_keys in $config): the gate checks every key of this account"
    keys=$(keys_parse "$f") || account_fatal "can't read $f (authorized_keys in $config)"
    while IFS=$tab read -r ln kind kopen kenv kcmd; do
      [ -n "$ln" ] || continue
      nlines=$((nlines + 1))
      id=$ln
      [ "$nfiles" -gt 1 ] && id="$f:$ln"
      # Without restrict, forwarding runs code without a signature: -L to docker.sock, say
      # (security review round 3).
      if [ "$kind" = cmd ]; then
        case $kopen in
          -) ;;
          restrict*) problems="$problems$nl  $f line $ln: add restrict, (else port forwarding and the like stay open)" ;;
        esac
        case ${kopen#restrict} in
          '' | - | ,) ;;
          *) problems="$problems$nl  $f line $ln: remove $(printf '%s' "${kopen#restrict}" | sed 's/^,//') (it turns on again what restrict turns off)" ;;
        esac
        # With PermitUserEnvironment, LD_PRELOAD or BASH_ENV there runs code before the gate
        # (security review round 4).
        [ "$kenv" = - ] || problems="$problems$nl  $f line $ln: remove environment= (it can load code into the gate and its programs)"
      fi
      case $kind in
        cmd)
          if u=$(line_unsigned "$kcmd"); then
            if [ "$u" = allow ]; then allow_ids="${allow_ids:+$allow_ids }$id"; else refuse_ids="${refuse_ids:+$refuse_ids }$id"; fi
          elif [ $? -eq 2 ]; then
            problems="$problems$nl  $f line $ln: its config $u is a file this account can change: make it and its folder root-owned and not writable by the account"
          else
            problems="$problems$nl  $f line $ln: command=\"$kcmd\" must be this gate ($0) with only its own options"
          fi
          ;;
        nocmd) problems="$problems$nl  $f line $ln: no command=\"$0 ...\": every key of this account must run the gate" ;;
        *) problems="$problems$nl  $f line $ln: can't read its options (an open quote, or two command= options)" ;;
      esac
    done <<EOF
$keys
EOF
  done
  [ -z "$problems" ] || account_fatal "this account's keys don't all run md-runbook-gate:$problems$nl  Give other keys their own account."
  [ "$nlines" -gt 0 ] || account_fatal "no key lines in $authorized_keys: set authorized_keys in $config to the files sshd reads (AuthorizedKeysFile)"
  if [ -n "$allow_ids" ] && [ -n "$refuse_ids" ]; then
    case $allow_ids in *' '*) a="lines $allow_ids allow" ;; *) a="line $allow_ids allows" ;; esac
    case $refuse_ids in *' '*) r="lines $refuse_ids" ;; *) r="line $refuse_ids" ;; esac
    account_fatal "$a unsigned blocks and $r don't: an account is all signed or all unsigned. Give the unsigned keys their own account."
  fi
  if [ -n "$allow_ids" ]; then account_kind=allow; else account_kind=refuse; fi
fi

# ---- what runs before the gate ----
# sshd starts the forced command with the account's login shell (`SHELL -c COMMAND`), and before
# that ~/.ssh/rc unless the key line or sshd_config turns it off. Debian's bash reads ~/.bashrc
# for `bash -c` under sshd, zsh ~/.zshenv: a file the account can write would run before every
# gate session (security review round 3). Only shells known to read nothing for `-c`: any other
# (bash, zsh, fish, csh, ...) is refused (security review round 4).
if [ "$login_shell_check" = yes ] && [ -n "${SSH_CLIENT:-}${SSH_CONNECTION:-}" ]; then
  login_shell=
  command -v getent >/dev/null 2>&1 && login_shell=$(getent passwd "$account" 2>/dev/null | cut -d: -f7)
  [ -n "$login_shell" ] || login_shell=${SHELL:-}
  case ${login_shell##*/} in
    sh | dash | ash | busybox | ksh | ksh93 | mksh | lksh | oksh | posh) ;;
    *) account_fatal "this account's login shell is ${login_shell:-unknown}: it can run files of the account before the gate (bash's ~/.bashrc, zsh's ~/.zshenv). Make it /bin/sh: usermod -s /bin/sh $account" ;;
  esac
fi
# sshd reads ~/.ssh/environment before the gate when sshd_config has PermitUserEnvironment yes:
# LD_PRELOAD there runs code in the gate itself (security review round 4). Refused either way.
_homes=${HOME:-}
# (Under sshd also the account's own home: environment= could have moved HOME.)
if [ -n "${SSH_CLIENT:-}${SSH_CONNECTION:-}" ] && command -v getent >/dev/null 2>&1; then
  _homes="$_homes$nl$(getent passwd "$account" 2>/dev/null | cut -d: -f6)"
fi
while IFS= read -r _h; do
  [ -n "$_h" ] || continue
  if [ -e "$_h/.ssh/environment" ] || [ -L "$_h/.ssh/environment" ]; then
    account_fatal "$_h/.ssh/environment can set the gate's environment: remove it, and keep PermitUserEnvironment no in sshd_config"
  fi
done <<EOF
$_homes
EOF
# With ForceCommand the key lines may lack restrict: sshd_config must say PermitUserRC no, and
# the gate refuses while there is a ~/.ssh/rc that sshd may have run.
if [ -n "$sshd_force_command" ] && { [ -e "${HOME:-}/.ssh/rc" ] || [ -L "${HOME:-}/.ssh/rc" ]; }; then
  account_fatal "${HOME:-}/.ssh/rc runs before the gate: remove it, and set PermitUserRC no in sshd_config"
fi
# This login's own options must be the account's kind: else its key is not where the gate looked.
[ "$unsigned" = "$account_kind" ] ||
  account_fatal "this login has unsigned = $unsigned, but the account's keys say $account_kind: is its key in $authorized_keys?"
if [ "$account_kind" = allow ] && [ -n "$report_on" ]; then
  # An unsigned trial: no report from this account may count as sent by a gate.
  report_on=
  report_problem="this account allows unsigned blocks: no run reports are sent"
fi

# ---- run reports (report_to in gate.conf) ----
# At the end of a session, one run summary per signed runbook the session ran (the format of
# docs/features/run-reports.md, client "gate"): its signed name, version, manifest hash and
# signers, the key (who), the server, account and client address, and each signed block's state.
# Never a parameter value or an output. Sent by curl in the background after the session, so it
# never holds up or fails a run; each try is logged as a `report` event.
#
# While the session runs, the gate keeps "N HASH CELL STEP TIME NONCE" per run in memory (STEP -
# for a whole block; NONCE random). The shell adds "N EXIT TIME NONCE" to $work/report-exits when
# run N ends: the nonce is in the text it gets after the block, so no block can write a line
# that counts for another run; the first line with the right nonce counts (security review
# round 3). A run with no end (the session was cut, or a block ran `exit`) makes the summary
# `stopped`.

# report_json HASH NOW: the summary of the runbook with manifest HASH, from the files above.
report_json() {
  rh=$1
  : >"$out/labels"
  for n in $(awk '$1 == "cell" { print $2 }' "$work/rb-$rh"); do
    is_num "$n" || continue
    code64=$(awk -v cell="$n" '$1 == "cell" { c = $2 } $1 == "code" && c == cell { print $2; exit }' "$work/rb-$rh")
    # The first line of the block's code with words, its spaces collapsed, at most 120 characters.
    label=$(printf '%s' "$code64" | b64d 2>/dev/null | awk 'NF { $1 = $1; print; exit }' | cut -c 1-120)
    [ -n "$label" ] || label="Step $n"
    last=$(awk -v cell="$n" '$1 == "cell" { c = $2 } $1 == "step" && c == cell { i++ } END { print i - 1 }' "$work/rb-$rh")
    printf '%s\t%s\t%s\n' "$n" "$(json_str "$label")" "$last" >>"$out/labels"
  done
  # A block's state is its last run's: failed on a non-zero exit; passed when it ran whole, or
  # its last command ran; otherwise (only some commands, or no end) not-run.
  # The file names through the environment: awk -v would read backslashes in them as escapes.
  tail=$(L="$out/labels" E="$work/report-exits" R="$out/runs" awk -F '\t' -v h="$rh" -v now="$2" '
    FILENAME == ENVIRON["L"] { label[$1] = $2; last[$1] = $3; if ($1 + 0 > cells) cells = $1 + 0; next }
    FILENAME == ENVIRON["R"] {
      if ($2 != h) next
      order[++runs] = $1; cell[$1] = $3 + 0; step[$1] = $4; st[$1] = $5; nonce[$1] = $6
      next
    }
    FILENAME == ENVIRON["E"] {
      if (($1 in nonce) && !($1 in rc) && nonce[$1] != "" && $4 == nonce[$1]) { rc[$1] = $2; et[$1] = $3 }
      next
    }
    END {
      for (i = 1; i <= runs; i++) {
        r = order[i]; c = cell[r]
        if (started == "") started = st[r]
        ran[c] = 1
        if (!(r in rc)) { state[c] = "not-run"; stopped = 1; continue }
        if (et[r] > ended) ended = et[r]
        if (rc[r] != 0) state[c] = "failed"
        else if (step[r] == "-" || step[r] + 0 == last[c] + 0) state[c] = "passed"
        else state[c] = "not-run"
      }
      steps = ""; rl = ""; p = 0; f = 0; nr = 0
      for (n = 1; n <= cells; n++) {
        s = (n in state) ? state[n] : "not-run"
        if (s == "passed") p++; else if (s == "failed") f++; else nr++
        steps = steps (n > 1 ? "," : "") "{\"n\":" n ",\"label\":" label[n] ",\"state\":\"" s "\"}"
        if (n in ran) rl = rl (rl == "" ? "" : ",") n
      }
      if (started == "") started = now
      if (ended == "" || stopped) ended = now
      printf "\"steps\":[%s],\"ran\":[%s],\"totals\":{\"steps\":%d,\"passed\":%d,\"failed\":%d,\"skipped\":0,\"notRun\":%d,\"byHand\":0},", steps, rl, cells, p, f, nr
      printf "\"green\":%s,\"started\":\"%s\",\"ended\":\"%s\"%s", (cells > 0 && f == 0 && nr == 0) ? "true" : "false", started, ended, stopped ? ",\"stopped\":true" : ""
    }' "$out/labels" "$out/runs" "$work/report-exits")
  # Name and version from the manifest itself (its hash was checked); the signers from memory
  # (a file next to it was a block's to change; security review round 4).
  rname=$(awk '$1 == "name" { print $2; exit }' "$work/rb-$rh")
  rversion=$(awk '$1 == "version" { print $2; exit }' "$work/rb-$rh")
  is_num "$rversion" || rversion=0
  rsigner=
  eval "rsigner=\${rb_signer_$rh-}"
  rsigner=$(printf '%s' "$rsigner" | cut -c 1-120)
  rwho=$(printf '%s' "${who:-$account}" | cut -c 1-120)
  rfrom=
  [ -n "$client" ] && rfrom=",\"from\":$(json_str "$(printf '%s' "$client" | cut -c 1-64)")"
  printf '{"v":1,"client":"gate","runbook":{"signed":{"name":%s,"version":%s,"manifest":"%s","signer":%s,"trusted":true}},"who":%s,"gate":{"host":%s,"account":%s%s},%s}' \
    "$(json_str "$rname")" "$rversion" "$rh" "$(json_str "$rsigner")" "$(json_str "$rwho")" \
    "$(json_str "$(uname -n 2>/dev/null | cut -c 1-255)")" "$(json_str "$(printf '%s' "$account" | cut -c 1-64)")" "$rfrom" "$tail"
}

# (In serve, which keeps the runs in memory.)
send_reports() {
  [ -n "$report_on" ] && [ -n "$report_runs" ] || return 0
  command -v curl >/dev/null 2>&1 || {
    log_event event report status skipped reason "no curl on this server"
    return 0
  }
  out=$(mktemp -d "${TMPDIR:-/tmp}/md-runbook-report.XXXXXX") || {
    log_event event report status skipped reason "can't create a folder for the report"
    return 0
  }
  # The token goes in a header file, never on curl's command line (other accounts see that).
  : >"$out/headers"
  if [ -n "$report_token_file" ]; then
    tok=$(tr -d ' \t\r\n' <"$report_token_file" 2>/dev/null)
    [ -n "$tok" ] || {
      log_event event report status skipped reason "can't read the token file $report_token_file"
      rm -rf "$out"
      return 0
    }
    printf 'authorization: Bearer %s\n' "$tok" >"$out/headers"
  fi
  printf 'content-type: application/json\n' >>"$out/headers"
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '%s' "$report_runs" >"$out/runs"
  : >>"$work/report-exits"
  i=0
  for h in $(cut -f 2 "$out/runs" | awk '!seen[$0]++'); do
    # The copy of the manifest is named by its hash: one a cell changed is not reported.
    printf '%s' "$h" | grep -qx '[0-9a-f]\{64\}' && [ -f "$work/rb-$h" ] && [ "$(sha256 "$work/rb-$h")" = "$h" ] || continue
    i=$((i + 1))
    report_json "$h" "$now" >"$out/$i.json"
    printf '%s\t%s\t%s\n' "$i" "$(awk '$1 == "name" { print $2; exit }' "$work/rb-$h")" "$(awk '$1 == "version" { print $2; exit }' "$work/rb-$h")" >>"$out/list"
  done
  [ "$i" -gt 0 ] || {
    rm -rf "$out"
    return 0
  }
  # In the background, detached from the SSH channel: the session ends now. Up to 3 tries.
  (
    trap '' HUP
    tab=$(printf '\t')
    while IFS=$tab read -r n rname rversion; do
      code=000
      for pause in 0 2 5; do
        [ "$pause" = 0 ] || sleep "$pause"
        code=$(curl -q -sS -o /dev/null -w '%{http_code}' --max-time 10 --proto =https,http -H @"$out/headers" --data-binary @"$out/$n.json" -- "$report_to" 2>/dev/null) || true
        case $code in 2??) break ;; 4??) [ "$code" = 408 ] || [ "$code" = 429 ] || break ;; esac
      done
      case $code in 2??) status=sent ;; *) status=failed ;; esac
      log_event event report status "$status" http "$code" url "$report_to" runbook "$rname" version "$rversion"
    done <"$out/list"
    rm -rf "$out"
  ) </dev/null >/dev/null 2>&1 3<&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
}

# ---- a session ----

# How the cells' shells get a process group of their own, so that their blocks' background
# programs end with them: setsid (Linux), else perl (macOS), else not (security review round 3).
# Without either, the gate refuses to start unless gate.conf says allow_no_group_kill = yes
# (security review round 4).
if group_bin=$(command -v setsid 2>/dev/null) && [ -n "$group_bin" ]; then
  group=setsid
elif group_bin=$(command -v perl 2>/dev/null) && [ -n "$group_bin" ]; then
  group=perl
else
  group=
  log_event event session-problem reason "no setsid or perl: a block's background programs can outlive the session"
  [ "$allow_no_group_kill" = yes ] ||
    fatal "no setsid or perl here: the gate can't end a block's background programs with its session. Install either, or set allow_no_group_kill = yes in $config"
fi

work=$(mktemp -d "${TMPDIR:-/tmp}/md-runbook-gate.XXXXXX") || fatal "can't create a work folder"
# The session's number: what its hello answers and a stop request names (see above).
token=$(od -An -N8 -tu8 /dev/urandom 2>/dev/null) || fatal "can't read /dev/urandom"
# shellcheck disable=SC2086
set -- $token
token=${1:-}
case $token in '' | *[!0-9]*) fatal "can't read /dev/urandom" ;; esac
while [ ${#token} -lt 14 ]; do token=0$token; done
# 1 and 14 digits: a whole number the app reads exactly (below 2^53).
token=1${token%"${token#??????????????}"}
skey=$(printf '%s' "$token" | sha256_in)
server=
reader=
# A short pause (sleep without fractions: a whole second).
nap() { sleep 0.2 2>/dev/null || sleep 1; }
# stop_groups PID...: each process group a PID leads (a shell and what its blocks started) gets
# TERM; what is left of them a second later, KILL. A block's `trap '' TERM` doesn't keep a
# program running (security review round 4). Without setsid or perl, the shells themselves.
stop_groups() {
  _t=
  for _p in "$@"; do
    is_pid "$_p" || continue
    if [ -n "$group" ]; then _t="$_t -$_p"; else _t="$_t $_p"; fi
  done
  [ -n "$_t" ] || return 0
  for _p in $_t; do kill -s TERM -- "$_p" 2>/dev/null; done
  _i=0
  while [ $_i -lt 5 ]; do
    _left=
    for _p in $_t; do kill -s 0 -- "$_p" 2>/dev/null && _left="$_left $_p"; done
    [ -n "$_left" ] || return 0
    nap
    _i=$((_i + 1))
  done
  for _p in $_left; do kill -s KILL -- "$_p" 2>/dev/null; done
  return 0
}

# ---- leftovers (kill_leftovers = yes) ----
# A program can outlive its session: it left its process group (setsid, a double fork), or it
# runs from cron. Such a leftover could write into a later session's shell through /proc (security
# review round 4). With kill_leftovers = yes, at the start of a session and at its end, the gate
# ends every process of this account that belongs to no live session. Linux only (/proc). Spared:
# - this session: everything under its topmost ancestor of this account (below PID 1);
# - every other login: anything under a process of another account (sshd's own, cron's);
# - PID 1, what came in from outside the PID namespace (docker exec, kubectl exec), and the
#   account's user manager (systemd --user and its sd-pam);
# - run-report senders of earlier sessions: this gate's interpreter running this script, and
#   curl, sleep, logger, date or rm under one.
# Processes of a live session are out of its reach: keep the account for the gate alone.
sys_bin() { _b=$(command -v "$1" 2>/dev/null) && readlink -f "$_b" 2>/dev/null; }
# leftover_list PS: "PID PPID" of each leftover, from `ps -e -o pid= -o ppid= -o uid= -o stat=`.
leftover_list() {
  printf '%s\n' "$1" | awk -v me="$$" -v uid="$uid" '
    $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { pp[$1] = $2; u[$1] = $3; z[$1] = ($4 ~ /^Z/); list[++n] = $1 }
    END {
      t = me
      while ((t in pp) && pp[t] > 1 && (pp[t] in u) && u[pp[t]] == uid) t = pp[t]
      for (i = 1; i <= n; i++) {
        p = list[i]
        if (u[p] != uid || p <= 1 || z[p]) continue
        q = p; spared = 0
        while (q > 1 && (q in pp)) {
          # (Parent 0 below PID 1: entered from outside the PID namespace, as docker exec.)
          if (q == t || u[q] != uid || pp[q] == 0) { spared = 1; break }
          q = pp[q]
        }
        if (!spared) print p, pp[p]
      }
    }'
}
sweep_leftovers() {
  [ "$kill_leftovers" = yes ] || return 0
  [ -r /proc/self/cmdline ] && [ -r "/proc/$$/exe" ] || {
    log_event event leftovers status skipped reason "no /proc here"
    return 0
  }
  # Never as root: every process of the system would be a leftover. (Root in a user namespace,
  # as in the tests, is fine.)
  if [ "$uid" = 0 ] && awk '$1 == 0 && $2 == 0 { found = 1 } END { exit !found }' /proc/self/uid_map 2>/dev/null; then
    log_event event leftovers status skipped reason "the account is root"
    return 0
  fi
  _me_exe=$(readlink "/proc/$$/exe")
  _me_args=$(tr '\0' '\n' <"/proc/$$/cmdline" | head -n 2)
  _helpers=
  for _b in curl sleep logger date rm; do _helpers="$_helpers $(sys_bin "$_b")"; done
  _sys=" $(readlink -f /usr/lib/systemd/systemd 2>/dev/null) $(readlink -f /lib/systemd/systemd 2>/dev/null) "
  _killed=
  _round=0
  # Stopped first (STOP can't be caught or ignored), then listed again for what they started
  # meanwhile, then killed.
  while [ $_round -lt 4 ]; do
    _ps=$(ps -e -o pid= -o ppid= -o uid= -o stat= 2>/dev/null) && [ -n "$_ps" ] || {
      log_event event leftovers status skipped reason "ps can't list the processes"
      break
    }
    _new=
    while read -r _p _pp; do
      is_pid "$_p" || continue
      case " $_killed " in *" $_p "*) continue ;; esac
      _x=$(readlink "/proc/$_p/exe" 2>/dev/null) || _x=
      # A report sender: this interpreter, this script, nothing in its environment that loads code.
      if [ -n "$_x" ] && [ "$_x" = "$_me_exe" ] && [ "$(tr '\0' '\n' <"/proc/$_p/cmdline" 2>/dev/null | head -n 2)" = "$_me_args" ] &&
        ! tr '\0' '\n' <"/proc/$_p/environ" 2>/dev/null | grep -Eq '^(LD_|BASH_ENV=|ENV=|BASH_FUNC_)'; then
        continue
      fi
      # What a report sender runs.
      case " $_helpers " in
        *" $_x "*)
          _px=$(readlink "/proc/$_pp/exe" 2>/dev/null) || _px=
          [ "$_px" = "$_me_exe" ] && [ "$(tr '\0' '\n' <"/proc/$_pp/cmdline" 2>/dev/null | head -n 2)" = "$_me_args" ] && continue
          ;;
      esac
      # The user manager (it starts the account's services again; those go).
      case $_sys in *" $_x "*) [ -n "$_x" ] && continue ;; esac
      kill -s STOP "$_p" 2>/dev/null && _new="$_new $_p"
    done <<EOF
$(leftover_list "$_ps")
EOF
    [ -n "$_new" ] || break
    _killed="$_killed$_new"
    _round=$((_round + 1))
  done
  [ -n "$_killed" ] || return 0
  # shellcheck disable=SC2086
  kill -s KILL $_killed 2>/dev/null
  log_event event leftovers status killed pids "${_killed# }" when "$1"
}
cleanup() {
  [ -n "$server" ] && kill "$server" 2>/dev/null
  # Every shell of the session, with what its blocks started. (Their pids, from the watchers.)
  set +f
  _pids=
  for p in "$work"/shell-*.pid; do
    [ -f "$p" ] && _pids="$_pids $(head -n 1 "$p")"
  done
  set -f
  # shellcheck disable=SC2086
  stop_groups $_pids
  # serve sends the run reports before it ends.
  [ -n "$server" ] && wait "$server" 2>/dev/null
  [ -n "$reader" ] && kill "$reader" 2>/dev/null
  rm -f "$state/pids/$skey"
  rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# The shell the cells run in: bash --noprofile --norc, else sh, found in gate.conf's path. It
# reads only what this gate writes; the cells themselves read /dev/null. Its environment: the
# names in cells_env_names from the gate's own, SHELL, PATH, LANG and KUBECONFIG from gate.conf,
# and MD_RUNBOOK_GATE_WHO (the key). During a signed run MD_RUNBOOK_GATE_RUN (its id) lets tools
# log against it (md-runbook-probe on the ops host).
if cells_bin=$(in_cells_path bash); then
  cells_args='--noprofile --norc'
elif cells_bin=$(in_cells_path sh); then
  cells_args=
else
  fatal "no bash or sh in path = $cells_path"
fi
log_event event session unsigned "$unsigned" scopes "$scopes" key_scopes "$key_scopes"
[ -n "$report_problem" ] && log_event event report status off reason "$report_problem"
[ -n "$report_on" ] && : >"$work/report-exits"
report_runs=
# Before the first shell: no leftover of an earlier session finds it.
sweep_leftovers start
# memory_limit: the soft limit of the gate's own processes, set in serve (the blocks' shells get
# this one back).
# shellcheck disable=SC3045
vlimit0=$(ulimit -S -v 2>/dev/null) || vlimit0=

# ---- the cells' shells (in serve) ----
# One for each signed runbook of the session: functions, aliases, traps, options and variables
# of another runbook don't carry over (security review, 2026-11-16). The cells of one runbook
# share theirs, as in a plain session, also when the session goes back to it after a call into
# another runbook (security review round 3). Up to 6 at a time, one per file descriptor 4 to 9:
# a 7th runbook ends the shell least recently used.
#
# Each shell reads a pipe only this gate holds: a FIFO in a folder of its own, removed as soon as
# both ends are open, so no other process can open it by name. (A process running as the account
# at the same time can still reach it through /proc: kill_leftovers ends those that outlived
# their session, at the start and end of each session; see the top of this file.)
#
# A watcher waits for each shell. When it ends by itself (`exit` in a cell), the session ends, as
# in a plain session; when it ends, its process group goes too (TERM, then KILL).
shells=0
uses=0
slots='4 5 6 7 8 9'
# The slot of fd N: sl_n_N (the shell's number), sl_hash_N (its runbook's manifest hash, '' for
# the session's first shell before a load), sl_dirty_N (it ran unsigned text), sl_used_N,
# sl_watch_N (the watcher's pid).
slot() {
  sv=
  eval "sv=\${sl_$1_$2-}"
}
slot_set() { eval "sl_$1_$2=\$3"; }
start_shell() {
  _fd=$1
  shells=$((shells + 1))
  _n=$shells
  _pd=$(mktemp -d "$work/pipe.XXXXXX") && mkfifo "$_pd/in" || {
    say "can't create a pipe"
    exit 2
  }
  (
    set -- SHELL="$cells_bin" PATH="$cells_path" LANG="$cells_locale" MD_RUNBOOK_GATE_WHO="$who"
    [ -n "$cells_kubeconfig" ] && set -- "$@" KUBECONFIG="$cells_kubeconfig"
    for _e in $cells_env_names; do
      eval "[ \"\${$_e+x}\" = x ]" || continue
      _v=
      eval "_v=\${$_e}"
      set -- "$@" "$_e=$_v"
    done
    # memory_limit is the gate's, not the blocks'.
    # shellcheck disable=SC3045
    [ -n "$vlimit0" ] && ulimit -S -v "$vlimit0" 2>/dev/null
    # shellcheck disable=SC2086
    case $group in
      setsid) env -i "$@" "$group_bin" "$cells_bin" $cells_args <"$_pd/in" & ;;
      perl) env -i "$@" "$group_bin" -e 'setpgrp(0, 0); exec { $ARGV[0] } @ARGV or die "md-runbook-gate: $!\n"' "$cells_bin" $cells_args <"$_pd/in" & ;;
      *) env -i "$@" "$cells_bin" $cells_args <"$_pd/in" & ;;
    esac
    sh_pid=$!
    printf '%s\n' "$sh_pid" | write_new "$work/shell-$_n.pid"
    wait "$sh_pid"
    stop_groups "$sh_pid"
    rm -f "$work/shell-$_n.pid"
    [ -e "$work/retired-$_n" ] || [ -L "$work/retired-$_n" ] || kill -TERM "$serve_pid" 2>/dev/null
  ) </dev/null 3<&- 4>&- 5>&- 6>&- 7>&- 8>&- 9>&- &
  slot_set watch "$_fd" $!
  eval "exec $_fd>\"\$_pd/in\""
  rm -rf "$_pd"
  slot_set n "$_fd" "$_n"
  slot_set hash "$_fd" ''
  slot_set dirty "$_fd" ''
}
# use_slot FD: the shell the next requests go to.
use_slot() {
  cur=$1
  uses=$((uses + 1))
  slot_set used "$cur" "$uses"
  pid_shown=
}
# The current shell's pid, for stop requests (a second connection): published once per switch,
# when the watcher has written it.
show_pid() {
  [ -z "$pid_shown" ] || return 0
  slot n "$cur"
  [ -f "$work/shell-$sv.pid" ] || return 0
  _p=$(head -n 1 "$work/shell-$sv.pid")
  is_pid "$_p" || return 0
  _t=$(mktemp "$state/pids/.new.XXXXXX") && printf '%s\n' "$_p" >"$_t" && mv -f "$_t" "$state/pids/$skey"
  pid_shown=1
}
# retire_shell FD: the shell ends once it has run what it was sent, then its process group.
retire_shell() {
  slot n "$1"
  [ -n "$sv" ] || return 0
  _n=$sv
  (set -C && : >"$work/retired-$_n") 2>/dev/null
  eval "exec $1>&-"
  slot watch "$1"
  wait "$sv"
  rm -f "$work/retired-$_n"
  [ "$1" = "$cur" ] && rm -f "$state/pids/$skey"
  slot_set n "$1" ''
  slot_set hash "$1" ''
  slot_set dirty "$1" ''
}
# shell_for HASH: the slot for the runbook with this manifest hash: its own shell; else the
# session's first one if it ran nothing yet; else a new one. A shell that ran unsigned text is
# never one a signed runbook gets (security review round 3).
shell_for() {
  # The current shell's runbook ('' for the session's first shell, before any load).
  slot hash "$cur"
  _h=$sv
  _to=
  for _s in $slots; do
    slot n "$_s"
    [ -n "$sv" ] || continue
    slot hash "$_s"
    [ "$sv" = "$1" ] && _to=$_s
  done
  if [ -n "$_to" ]; then
    slot dirty "$_to"
    if [ -n "$sv" ]; then
      retire_shell "$_to"
      start_shell "$_to"
    fi
  else
    slot dirty "$cur"
    if [ -z "$_h" ] && [ -z "$sv" ]; then
      _to=$cur
    else
      # A free slot, else the one least recently used.
      _old=
      for _s in $slots; do
        slot n "$_s"
        if [ -z "$sv" ]; then
          _to=$_s
          break
        fi
        [ "$_s" = "$cur" ] && continue
        slot used "$_s"
        if [ -z "$_old" ] || [ "$sv" -lt "$_oldu" ]; then
          _old=$_s
          _oldu=$sv
        fi
      done
      if [ -z "$_to" ]; then
        _to=$_old
        retire_shell "$_to"
      fi
      start_shell "$_to"
    fi
  fi
  # The session's first shell, left without a runbook, is of no more use.
  if [ "$cur" != "$_to" ] && [ -z "$_h" ]; then
    retire_shell "$cur"
  fi
  slot_set hash "$_to" "$1"
  use_slot "$_to"
}

loaded=
manifest=
principal=
mhash=
mname=
mversion=
step_cell=
step_next=
# Runs are numbered by the gate (for the report), not by the client's request id.
runs=0
# The parameters' names (their values in __p_NAME) and the names exported to the shell for the
# loaded runbook, unset when the next one loads. In memory only: nothing a cell could change.
pnames=
exported=
add_exported() {
  case " $exported " in *" $1 "*) ;; *) exported="${exported:+$exported }$1" ;; esac
}
clear_params() {
  for _n in $pnames; do unset "__p_$_n"; done
  pnames=
}

# The manifest's items: field N of its first `KEY ...` line in cell $2 (or at the top with '').
# From the verified copy in memory, never from a file a cell could change.
mfield() { printf '%s' "$manifest" | awk -v key="$1" -v cell="$2" -v f="$3" '$1 == "cell" { c = $2 } $1 == key && (cell == "" || c == cell) { print $f; exit }'; }

# load ID MANIFEST SIGNATURE [SIGNATURE ...]: up to 5 signatures of the one manifest (author,
# reviewer, ...); the server's `signers` says how many distinct trusted signers it needs.
do_load() {
  rid=$1
  shift
  # A `called` or `note` request is for this load only, whether it succeeds or not.
  cb=$called_by
  cc=$called_call
  called_by=
  called_call=
  na=$note_alert
  nf=$note_fingerprint
  ns=$note_starts_at
  note_alert=
  note_fingerprint=
  note_starts_at=
  ok=
  [ $# -ge 2 ] && [ $# -le 6 ] && ok=1
  for a in "$@"; do is_b64 "$a" || ok=; done
  [ -n "$ok" ] || {
    refuse "$rid" "bad load request"
    return
  }
  manifest64=$1
  shift
  loaded=
  clear_params
  # The previous runbook's parameters and env.* values don't carry over to this one.
  if [ -n "$exported" ]; then
    printf 'unset %s\n' "$exported" >&"$cur"
    exported=
  fi
  # Kept in memory: what was verified is what runs (a trailing . keeps the final newline).
  manifest=$(printf '%s' "$manifest64" | b64d 2>/dev/null && echo .) || {
    manifest=
    refuse "$rid" "the manifest is not base64"
    return
  }
  manifest=${manifest%.}
  # Version 2 manifests keep this header: their `text` item (a hash of the whole runbook, for
  # clients) is read by no one here, as items are read by key.
  [ "${manifest%%"$nl"*}" = 'md-runbook-manifest 1' ] || {
    refuse "$rid" "not an md-runbook manifest, or a newer version than this gate reads"
    return
  }
  [ -r "$allowed_signers" ] || {
    refuse "$rid" "this server trusts no signers yet ($allowed_signers)"
    return
  }
  # Each signature that verifies counts once per principal (two signatures of one key are one
  # signer); a signature from a key this server doesn't trust counts for nothing.
  principals=
  count=0
  for sig in "$@"; do
    sigf=$(new_name sig) && {
      echo '-----BEGIN SSH SIGNATURE-----'
      printf '%s' "$sig" | fold -w 70
      echo
      echo '-----END SSH SIGNATURE-----'
    } | write_new "$sigf" || continue
    found=
    # One allowed_signers line may name several principals (a,b): try each.
    for p in $(ssh-keygen -Y find-principals -s "$sigf" -f "$allowed_signers" 2>/dev/null | tr ',' ' '); do
      if printf '%s' "$manifest" | ssh-keygen -Y verify -f "$allowed_signers" -I "$p" -n md-runbook -s "$sigf" >/dev/null 2>&1; then
        found=$p
        break
      fi
    done
    rm -f "$sigf"
    [ -n "$found" ] || continue
    case " $principals " in
      *" $found "*) ;;
      *)
        principals="${principals:+$principals }$found"
        count=$((count + 1))
        ;;
    esac
  done
  [ "$count" -gt 0 ] || {
    refuse "$rid" "the signature is not from a trusted signer (or the runbook was changed after signing)"
    return
  }
  principal=$(printf '%s' "$principals" | tr ' ' ',')
  mhash=$(printf '%s' "$manifest" | sha256_in)
  mname=$(mfield name '' 2)
  mversion=$(mfield version '' 2)
  # As core's parseManifest reads it: name, version, expires and scope once each (this reads the
  # first one, core refuses a second), the version a whole number (a word made the floors check
  # below fail open) and expires a date (security review, 2026-11-16).
  dup=$(printf '%s' "$manifest" | awk '$1 == "name" || $1 == "version" || $1 == "expires" || $1 == "scope" { if (seen[$1]++) { print $1; exit } }')
  [ -z "$dup" ] || {
    refuse "$rid" "the manifest has more than one $dup line"
    return
  }
  is_num "$mversion" && [ "$mversion" -ge 1 ] || {
    refuse "$rid" "the manifest's version is not a whole number"
    return
  }
  case $(mfield expires '' 2) in
    '' | [0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]) ;;
    *)
      refuse "$rid" "the manifest's expires is not a date (YYYY-MM-DD)"
      return
      ;;
  esac
  [ "$count" -ge "$signers" ] || {
    refuse "$rid" "$mname version $mversion needs $signers signers here; signed by $principal"
    return
  }
  if [ -n "$revoked" ]; then
    [ -r "$revoked" ] || {
      refuse "$rid" "can't read the revoked list $revoked"
      return
    }
    # One hash per line, as md-runbook verify prints it; tolerant of CRLF, blanks, upper case and a sha256: prefix.
    if tr -d '\r \t' <"$revoked" | tr 'A-F' 'a-f' | sed 's/^sha256://' | grep -qx "$mhash"; then
      refuse "$rid" "$mname version $mversion was withdrawn (revoked)"
      return
    fi
  fi
  # Version floors: `NAME LOWEST` per line; versions of that runbook below LOWEST are withdrawn.
  if [ -n "$floors" ]; then
    [ -r "$floors" ] || {
      refuse "$rid" "can't read the floors list $floors"
      return
    }
    floor=$(tr -d '\r' <"$floors" | awk -v n="$mname" '{ sub(/#.*/, "") } $1 == n && $2 ~ /^[0-9]+$/ { print $2; exit }')
    # A floor too big for test(1) must not make the check fail open: refuse instead.
    if [ -n "$floor" ] && ! is_num "$floor"; then
      refuse "$rid" "the floors list has a bad version for $mname ($floor)"
      return
    fi
    if [ -n "$floor" ] && [ "$mversion" -lt "$floor" ]; then
      refuse "$rid" "$mname version $mversion is older than the lowest version this server runs ($floor)"
      return
    fi
  fi
  expires=$(mfield expires '' 2)
  if [ -n "$expires" ] && awk -v a="$(date -u +%Y-%m-%d)" -v b="$expires" 'BEGIN { exit !(a > b) }'; then
    refuse "$rid" "$mname version $mversion expired on $expires"
    return
  fi
  mscopes=$(printf '%s' "$manifest" | awk '$1 == "scope" { sub(/^scope +/, ""); print; exit }')
  ok=
  if [ -z "$mscopes" ]; then
    [ "$scopes" = '*' ] && { [ -z "$key_scopes" ] || [ "$key_scopes" = '*' ]; } && ok=1
  else
    for s in $mscopes; do
      has_scope "$scopes" "$s" && { [ -z "$key_scopes" ] || has_scope "$key_scopes" "$s"; } && ok=1
    done
  fi
  [ -n "$ok" ] || {
    refuse "$rid" "$mname is for ${mscopes:-no scope}; this server or key accepts ${key_scopes:-$scopes}"
    return
  }
  for n in $(printf '%s' "$manifest" | awk '$1 == "param" || $1 == "env" { print $2 }'); do
    if ! is_var "$n" || is_reserved "$n"; then
      refuse "$rid" "$mname sets $n, a name the gate doesn't let a runbook set"
      return
    fi
  done
  # This runbook's own shell (the same one loaded again, or after a call, keeps it).
  shell_for "$mhash"
  loaded=1
  step_cell=
  # For the run report: what this manifest is, kept by its hash for the end of the session.
  # Its signers stay in memory: the first load's, as the manifest's copy.
  if [ -n "$report_on" ] && [ ! -e "$work/rb-$mhash" ]; then
    t=$(new_name rb) && printf '%s' "$manifest" | write_new "$t" && mv -f "$t" "$work/rb-$mhash"
  fi
  case $mhash in
    '' | *[!0-9a-f]*) ;;
    *) eval "[ -n \"\${rb_signer_$mhash-}\" ]" || eval "rb_signer_$mhash=\$principal" ;;
  esac
  log_load
  printf '\036__MDRB_SIGNED__ %s %s\n' "$principal" "$mhash"
  marker "$rid" 0
}

# called ID HASH N: the next load is called by call N of the runbook whose manifest has sha256 HASH.
called_by=
called_call=
do_called() {
  rid=$1
  if [ $# -eq 3 ] && printf '%s' "$2" | grep -qx '[0-9a-f]\{64\}' && is_num "$3"; then
    called_by=$2
    called_call=$3
    marker "$rid" 0
  else
    refuse "$rid" "bad called request"
  fi
}

# The load event, with what a `called` or `note` request said about it.
log_load() {
  set -- event load id "$rid" runbook "$mname" version "$mversion" hash "$mhash" signer "$principal"
  [ -n "$cb" ] && set -- "$@" called-by "$cb" call "$cc"
  [ -n "$na" ] && set -- "$@" alert "$na"
  [ -n "$nf" ] && set -- "$@" alert-fingerprint "$nf"
  [ -n "$ns" ] && set -- "$@" alert-starts-at "$ns"
  log_event "$@"
}

# note ID KEY VALUE ...: (protocol 3) the next load answers this alert, as the client says. Only
# for the log: it grants nothing and runs nothing. Each value is base64 and checked strictly:
# ALERT (required) 1 to 400 bytes, ALERT_FINGERPRINT letters, digits and . _ : - (at most 128),
# ALERT_STARTS_AT an RFC 3339 time; none with a control character; each key once. A bad note is
# refused whole (and kept from no load).
note_alert=
note_fingerprint=
note_starts_at=
do_note() {
  rid=$1
  shift
  n_alert=
  n_fp=
  n_start=
  n_seen=
  ok=
  [ $# -ge 2 ] && [ $# -le 6 ] && [ $(($# % 2)) -eq 0 ] && ok=1
  while [ -n "$ok" ] && [ $# -ge 2 ]; do
    n_key=$1
    n_b64=$2
    shift 2
    case " $n_seen " in
      *" $n_key "*)
        ok=
        break
        ;;
    esac
    n_seen="$n_seen $n_key"
    # The base64 of 400 bytes is 536 characters: nothing longer is decoded.
    is_b64 "$n_b64" && [ ${#n_b64} -le 600 ] && printf '%s' "$n_b64" | b64d >/dev/null 2>&1 || {
      ok=
      break
    }
    n_len=$(printf '%s' "$n_b64" | b64d | wc -c | tr -d ' ')
    # One line of text: no newline, NUL or other control character.
    [ "$(printf '%s' "$n_b64" | b64d | tr -d '\000-\037\177' | wc -c | tr -d ' ')" = "$n_len" ] && [ "$n_len" -gt 0 ] || {
      ok=
      break
    }
    n_val=$(printf '%s' "$n_b64" | b64d)
    case $n_key in
      ALERT)
        [ "$n_len" -le 400 ] || ok=
        n_alert=$n_val
        ;;
      ALERT_FINGERPRINT)
        case $n_val in *[!A-Za-z0-9._:-]*) ok= ;; esac
        [ "$n_len" -le 128 ] || ok=
        n_fp=$n_val
        ;;
      ALERT_STARTS_AT)
        printf '%s\n' "$n_val" | grep -Eqx '[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}(:[0-9]{2}(\.[0-9]{1,9})?)?([Zz]|[+-][0-9]{2}:?[0-9]{2})?' || ok=
        n_start=$n_val
        ;;
      *) ok= ;;
    esac
  done
  [ -n "$ok" ] && [ -n "$n_alert" ] || {
    refuse "$rid" "bad note request"
    return
  }
  note_alert=$n_alert
  note_fingerprint=$n_fp
  note_starts_at=$n_start
  marker "$rid" 0
}

do_param() {
  rid=$1
  # An empty value is an empty base64 field.
  [ $# -eq 2 ] && set -- "$1" "$2" ""
  [ $# -eq 3 ] && is_var "$2" && is_b64 "$3" || {
    refuse "$rid" "bad param request"
    return
  }
  [ -n "$loaded" ] || {
    refuse "$rid" "no signed runbook loaded"
    return
  }
  pat64=$(printf '%s' "$manifest" | awk -v n="$2" '$1 == "param" && $2 == n { print $3; exit }')
  [ -n "$pat64" ] || {
    refuse "$rid" "$mname has no parameter $2"
    return
  }
  pat=$(printf '%s' "$pat64" | b64d)
  value=$(printf '%s' "$3" | b64d 2>/dev/null && echo .) || {
    refuse "$rid" "bad value for $2"
    return
  }
  value=${value%.}
  # One line, matching the whole pattern.
  case $value in *"$nl"*) value_ok= ;; *) value_ok=1 ;; esac
  if [ -z "$value_ok" ] || ! printf '%s\n' "$value" | grep -Eqx -e "$pat"; then
    refuse "$rid" "the value of $2 doesn't match its pattern $pat"
    return
  fi
  eval "__p_$2=\$value"
  case " $pnames " in *" $2 "*) ;; *) pnames="${pnames:+$pnames }$2" ;; esac
  log_event event param id "$rid" runbook "$mname" name "$2" value "$value"
  marker "$rid" 0
}

# The last kube-context= of a fence info string (on stdin), read as core's tokenizeInfo reads it:
# after the language word, key=value, key="quoted" or key='quoted', bare flags, {…} skipped, keys
# in any case. Prints =VALUE (trimmed), or nothing when there is none.
kube_want() {
  awk '
    NR == 1 { s = $0; next }
    { s = s "\n" $0 }
    END {
      sub(/^[ \t\n\r\f\v]*[^ \t\n\r\f\v{]*/, "", s)
      n = length(s); i = 1; found = 0; want = ""
      while (i <= n) {
        while (i <= n && (substr(s, i, 1) == " " || substr(s, i, 1) == "\t")) i++
        if (i > n) break
        if (substr(s, i, 1) == "{") {
          j = index(substr(s, i), "}")
          if (j == 0) i = n + 1; else i += j
          continue
        }
        st = i
        while (i <= n && substr(s, i, 1) != " " && substr(s, i, 1) != "\t" && substr(s, i, 1) != "=") i++
        key = substr(s, st, i - st)
        if (substr(s, i, 1) != "=") continue
        i++
        q = substr(s, i, 1)
        if (q == "\"" || q == "\047") {
          j = index(substr(s, i + 1), q)
          if (j == 0) { v = substr(s, i + 1); i = n + 1 } else { v = substr(s, i + 1, j - 1); i += j + 1 }
        } else {
          vs = i
          while (i <= n && substr(s, i, 1) != " " && substr(s, i, 1) != "\t") i++
          v = substr(s, vs, i - vs)
        }
        if (key != "" && tolower(key) == "kube-context") { want = v; found = 1 }
      }
      if (found) { gsub(/^[ \t\n\r\f\v]+|[ \t\n\r\f\v]+$/, "", want); print "=" want }
    }'
}

# Write the commands that run the code $3 in the shell, with the cell's cwd= and environment.
# The code goes through the shell's pipe itself, single-quoted, and runs as the body of a
# function (`return` ends the block, as `.` did). Never a file: a file can be swapped between a
# hash check and the read (a FIFO serves the check one text and the shell another; security
# review round 3). $4: the nonce of this run's line in report-exits.
emit_run() {
  rid=$1
  cell=$2
  code=$3
  nonce=$4
  show_pid
  {
    for n in $pnames; do
      is_var "$n" && ! is_reserved "$n" || continue
      eval "v=\${__p_$n}"
      printf 'export %s=%s\n' "$n" "$(sq "$v")"
      add_exported "$n"
    done
    for kv in $(printf '%s' "$manifest" | awk -v cell="$cell" '$1 == "cell" { c = $2 } $1 == "env" && c == cell { print $2 "=" $3 }'); do
      k=${kv%%=*}
      is_var "$k" && ! is_reserved "$k" || continue
      printf 'export %s=%s\n' "$k" "$(sq "$(printf '%s' "${kv#*=}" | b64d)")"
      add_exported "$k"
    done
    printf '__mdrb_id=%s\n__mdrb_rc=0\n__mdrb_kr=\n' "$rid"
    # The code, quoted as sq does, with its last newline (a here-document may end the block).
    printf "__mdrb_c='"
    printf '%s\n' "$code" | sed "s/'/'\\\\''/g"
    printf "'\n"
    printf 'export MD_RUNBOOK_GATE_RUN=%s\n' "$rid"
    cwd64=$(mfield cwd "$cell" 2)
    if [ -n "$cwd64" ]; then
      printf '__mdrb_dir=%s\n' "$(sq "$(printf '%s' "$cwd64" | b64d)")"
      cat <<'EOF'
__mdrb_cd=$PWD; __mdrb_in=; if cd -- "$__mdrb_dir"; then __mdrb_in=1; else __mdrb_rc=1; fi
EOF
    fi
    if [ -n "$kube" ]; then
      json_v "$account"
      ja=$jv
      json_v "$who"
      jw=$jv
      json_v "$client"
      printf '__mdrb_kw=%s\n__mdrb_who=%s\n' "$(sq "$kube")" "$(sq "\"account\":$ja,\"who\":$jw,\"client\":$jv")"
      # kubectl's current context with the cell's environment (env.KUBECONFIG) and folder; the
      # name as logged keeps only the characters a context name has.
      cat <<'EOF'
if [ "$__mdrb_rc" = 0 ]; then __mdrb_kc=$(command kubectl config current-context </dev/null 2>/dev/null) || __mdrb_kc=; if [ "$__mdrb_kc" != "$__mdrb_kw" ]; then __mdrb_kc=$(printf '%s' "$__mdrb_kc" | tr -cd 'A-Za-z0-9._:@/+-' | cut -c 1-253); printf '%s\n' "md-runbook-gate: this block is for the Kubernetes context $__mdrb_kw; the current context here is ${__mdrb_kc:-none}: nothing ran" >&2; __mdrb_rc=126; __mdrb_kr="kube-context is ${__mdrb_kc:-none}, not $__mdrb_kw"; fi; fi
EOF
      if [ "$log" = syslog ]; then
        cat <<'EOF'
[ -n "$__mdrb_kr" ] && logger -t md-runbook-gate -- "{\"time\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",$__mdrb_who,\"event\":\"refused\",\"id\":\"$__mdrb_id\",\"reason\":\"$__mdrb_kr\"}" 2>/dev/null
EOF
      else
        printf '__mdrb_log=%s\n' "$(sq "$log")"
        cat <<'EOF'
[ -n "$__mdrb_kr" ] && printf '%s\n' "{\"time\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",$__mdrb_who,\"event\":\"refused\",\"id\":\"$__mdrb_id\",\"reason\":\"$__mdrb_kr\"}" >>"$__mdrb_log" 2>/dev/null
EOF
      fi
    fi
    cat <<'EOF'
if [ "$__mdrb_rc" = 0 ]; then __mdrb_run() { eval "$__mdrb_c"; }; __mdrb_run </dev/null; __mdrb_rc=$?; fi; unset -f __mdrb_run; unset __mdrb_c
EOF
    [ -n "$cwd64" ] && echo '[ -n "$__mdrb_in" ] && cd -- "$__mdrb_cd" 2>/dev/null'
    if [ -n "$report_on" ]; then
      # The nonce only in what the shell reads after the block.
      printf '__mdrb_n=%s\n__mdrb_rx=%s\n' "$runs" "$(sq "$work/report-exits")"
      printf 'printf '\''%%s\\t%%s\\t%%s\\t%%s\\n'\'' "$__mdrb_n" "$__mdrb_rc" "$(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ)" %s >>"$__mdrb_rx" 2>/dev/null\n' "$nonce"
    fi
    if [ "$log" = syslog ]; then
      cat <<'EOF'
logger -t md-runbook-gate -- "{\"time\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"event\":\"end\",\"id\":\"$__mdrb_id\",\"exit\":$__mdrb_rc}" 2>/dev/null
EOF
    else
      printf '__mdrb_log=%s\n' "$(sq "$log")"
      cat <<'EOF'
printf '%s\n' "{\"time\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"event\":\"end\",\"id\":\"$__mdrb_id\",\"exit\":$__mdrb_rc}" >>"$__mdrb_log" 2>/dev/null
EOF
    fi
    cat <<'EOF'
printf '\036%s %s\n' "__MDRB_${__mdrb_id}__" "$__mdrb_rc" >&2; printf '\036%s %s\n' "__MDRB_${__mdrb_id}__" "$__mdrb_rc"
EOF
  } >&"$cur"
}

# do_run ID CELL [K]: a whole signed cell, or its K-th command.
do_run() {
  rid=$1
  cell=$2
  k=${3:-}
  [ -n "$loaded" ] || {
    refuse "$rid" "no signed runbook loaded"
    return
  }
  mode=$(mfield cell "$cell" 3)
  [ -n "$mode" ] || {
    refuse "$rid" "$mname has no signed cell $cell"
    return
  }
  for p in $(printf '%s' "$manifest" | awk -v cell="$cell" '$1 == "cell" { c = $2 } $1 == "needs" && c == cell { print $2 }'); do
    case " $pnames " in
      *" $p "*) ;;
      *)
        refuse "$rid" "$mname needs a value for the parameter $p"
        return
        ;;
    esac
  done
  # kube-context= in the signed info string: the gate checks it itself, in the shell, with the
  # cell's env.* (a client could skip the `context` request; security review, 2026-11-16).
  kube=$(mfield info "$cell" 2 | b64d 2>/dev/null | kube_want)
  if [ -n "$kube" ]; then
    kube=${kube#=}
    case $kube in
      '${param:'*'}')
        kp=${kube#'${param:'}
        kp=${kp%'}'}
        is_var "$kp" || {
          refuse "$rid" "cell $cell has a kube-context the gate can't read: $kube"
          return
        }
        case " $pnames " in
          *" $kp "*) eval "kube=\${__p_$kp}" ;;
          *)
            refuse "$rid" "$mname needs a value for the parameter $kp (its kube-context)"
            return
            ;;
        esac
        ;;
    esac
    printf '%s\n' "$kube" | grep -Eqx '[A-Za-z0-9][A-Za-z0-9._:@/+-]{0,252}' || {
      refuse "$rid" "cell $cell's kube-context is not a Kubernetes context name: $kube"
      return
    }
  fi
  if [ -z "$k" ]; then
    code64=$(mfield code "$cell" 2)
    step_cell=
  else
    # Commands run in order (Step through, Run lines 1-N) unless the cell is signed with lines=any.
    if [ "$mode" != any ] && [ "$k" != 0 ] && ! { [ "$step_cell" = "$cell" ] && [ "$k" = "$step_next" ]; }; then
      refuse "$rid" "cell $cell runs whole or its lines in order; single lines need lines=any in the signed runbook"
      return
    fi
    code64=$(printf '%s' "$manifest" | awk -v cell="$cell" -v k="$k" '$1 == "cell" { c = $2; i = 0 } $1 == "step" && c == cell { if (i == k) { print $2; exit } i++ }')
    [ -n "$code64" ] || {
      refuse "$rid" "cell $cell has no command $k"
      return
    }
    step_cell=$cell
    step_next=$((k + 1))
  fi
  code=$(printf '%s' "$code64" | b64d 2>/dev/null && echo .) || {
    refuse "$rid" "bad cell in the manifest"
    return
  }
  code=${code%.}
  # Unsigned text ran in this runbook's shell since its load: a fresh one, as a load would give
  # (security review round 4).
  slot dirty "$cur"
  [ -z "$sv" ] || shell_for "$mhash"
  runs=$((runs + 1))
  log_event event run id "$rid" runbook "$mname" version "$mversion" hash "$mhash" signer "$principal" cell "$cell" step "$k"
  nonce=
  if [ -n "$report_on" ]; then
    nonce=$(od -An -N8 -tx1 /dev/urandom 2>/dev/null | tr -cd '0-9a-f')
    report_runs="$report_runs$runs	$mhash	$cell	${k:--}	$(date -u +%Y-%m-%dT%H:%M:%SZ)	$nonce$nl"
  fi
  emit_run "$rid" "$cell" "$code" "$nonce"
}

do_raw() {
  rid=$1
  [ $# -eq 2 ] && is_b64 "$2" || {
    refuse "$rid" "bad raw request"
    return
  }
  [ "$unsigned" = allow ] || {
    refuse "$rid" "this server runs signed runbooks only (this cell is not signed, or changed since signing)"
    return
  }
  printf '%s' "$2" | b64d >/dev/null 2>&1 || {
    refuse "$rid" "bad raw request"
    return
  }
  # Straight to the shell, never to disk: the text exports the cell's secret values.
  log_event event unsigned id "$rid" hash "$(printf '%s' "$2" | b64d | sha256_in)"
  # This shell ran unsigned text: no signed runbook gets it again (security review round 3), and
  # the next signed run of the loaded one starts a fresh shell (round 4).
  slot_set dirty "$cur" 1
  show_pid
  # Not a signed run: tools must not log against the last one.
  printf 'unset MD_RUNBOOK_GATE_RUN\n' >&"$cur"
  printf '%s' "$2" | b64d >&"$cur"
}

# do_context ID: `kubectl config current-context` in the shell, for the app's kube-context guard.
# Answered whether or not unsigned cells may run: it only reads the kubeconfig.
do_context() {
  rid=$1
  [ $# -eq 1 ] || {
    refuse "$rid" "bad context request"
    return
  }
  log_event event context id "$rid"
  show_pid
  {
    printf '__mdrb_id=%s\n' "$rid"
    echo 'kubectl config current-context </dev/null; __mdrb_rc=$?'
    cat <<'EOF'
printf '\036%s %s\n' "__MDRB_${__mdrb_id}__" "$__mdrb_rc" >&2; printf '\036%s %s\n' "__MDRB_${__mdrb_id}__" "$__mdrb_rc"
EOF
  } >&"$cur"
}

serve() {
  # This subshell's own pid (a child's parent): the watcher stops it when the shell ends by itself.
  serve_pid=$(exec sh -c 'echo "$PPID"')
  # A TERM (the watcher, or the gate ending) ends the loop below; then the run reports go out.
  serve_term=
  trap 'serve_term=1' HUP INT TERM
  # A bound on what a client can make the gate hold (security review round 4).
  if [ "$memory_limit" != 0 ]; then
    # shellcheck disable=SC3045
    ulimit -S -v $((memory_limit * 1024)) 2>/dev/null || log_event event session-problem reason "can't set memory_limit here (ulimit -v)"
  fi
  start_shell 4
  use_slot 4
  while [ -z "$serve_term" ] && IFS= read -r line; do
    # The reader below cuts lines at 4000001 bytes: a longer request ends the session.
    [ ${#line} -le 4000000 ] || {
      say "request too long: the session ends"
      log_event event refused reason "request too long"
      break
    }
    # shellcheck disable=SC2086
    set -- $line
    verb=${1:-}
    [ $# -ge 1 ] && shift
    if [ "$verb" = : ]; then
      # : mdrb-gate-hello ID; printf ...: the app's first line (a plain shell runs it as is).
      rid=${2:-}
      rid=${rid%;}
      if [ "${1:-}" = mdrb-gate-hello ] && is_id "$rid"; then
        printf '\036__MDRB_GATE__ %s unsigned=%s\n' "$GATE_PROTOCOL" "$unsigned"
        marker "$rid" "$token"
      else
        say "this account runs md-runbook-gate: connect with the md-runbook app"
      fi
      continue
    fi
    rid=${1:-}
    is_id "$rid" || {
      say "this account runs md-runbook-gate: connect with the md-runbook app"
      continue
    }
    case $verb in
      load) do_load "$@" ;;
      called) do_called "$@" ;;
      note) do_note "$@" ;;
      param) do_param "$@" ;;
      run) if [ $# -eq 2 ] && is_num "$2"; then do_run "$1" "$2"; else refuse "$rid" "bad run request"; fi ;;
      step) if [ $# -eq 3 ] && is_num "$2" && is_num "$3"; then do_run "$1" "$2" "$3"; else refuse "$rid" "bad step request"; fi ;;
      raw) do_raw "$@" ;;
      context) do_context "$@" ;;
      *) refuse "$rid" "unknown request $verb" ;;
    esac
  done
  # The client is done: each shell runs what it was sent, then ends. Cut short (TERM): they end now.
  if [ -n "$serve_term" ]; then
    _pids=
    for _s in $slots; do
      slot n "$_s"
      [ -n "$sv" ] && [ -f "$work/shell-$sv.pid" ] && _pids="$_pids $(head -n 1 "$work/shell-$sv.pid")"
    done
    # shellcheck disable=SC2086
    stop_groups $_pids
  fi
  for _s in $slots; do
    retire_shell "$_s"
  done
  # What left the shells' process groups, before the report senders start.
  sweep_leftovers end
  send_reports
}

# The requests reach serve cut, as `fold -b -w 4000001` cuts them: a line longer than 4000000
# bytes arrives in pieces, the first 4000001 bytes long, so `read` never holds more (before, a 32
# MB line took 67 MB and 24 seconds; security review round 4). perl, else stdbuf and fold (fold
# alone holds its output back); through a FIFO removed once open, as the shells' pipes.
cut_lines() {
  if command -v perl >/dev/null 2>&1; then
    # shellcheck disable=SC2016
    exec perl -e '$| = 1; $l = 0; $w = 4000001;
      while (sysread(STDIN, $b, 65536)) {
        $o = "";
        for $p (split /(?<=\n)/, $b) {
          $e = chomp $p;
          while ($l + length($p) > $w) { $k = $w - $l; $o .= substr($p, 0, $k, "") . "\n"; $l = 0 }
          $o .= $p; $l += length($p);
          if ($e) { $o .= "\n"; $l = 0 }
        }
        while (length $o) { $n = syswrite(STDOUT, $o); exit 0 unless defined $n; substr($o, 0, $n, "") }
      }'
  elif command -v stdbuf >/dev/null 2>&1; then
    exec stdbuf -oL fold -b -w 4000001
  else
    log_event event session-problem reason "no perl or stdbuf: long requests aren't cut before they are read"
    exec cat
  fi
}
exec 3<&0
_rd=$(mktemp -d "$work/pipe.XXXXXX") && mkfifo "$_rd/in" || fatal "can't create a pipe"
cut_lines <&3 >"$_rd/in" 2>/dev/null 3<&- &
reader=$!
exec 3<"$_rd/in"
rm -rf "$_rd"
serve <&3 3<&- &
server=$!
exec 3<&- 0</dev/null
wait "$server"
server=
log_event event end-session
exit 0
