# /etc/md-runbook/gate.conf: the policy of md-runbook-gate on this server.
# A key's own options (--unsigned=, --scopes=) override it for that key.

# Blocks that are not signed (or changed since signing): refuse, or allow (still logged).
unsigned = refuse

# Signed runbooks for these scopes run here, space-separated; * = any (runbooks without scopes
# run only where this is *).
scopes = *

# The publishers' keys (OpenSSH allowed_signers format, namespaces="md-runbook").
allowed_signers = /etc/md-runbook/allowed_signers

# Withdrawn releases: manifest sha256 hashes, one per line (md-runbook verify shows a runbook's).
# revoked = /etc/md-runbook/revoked

# Version floors: `NAME LOWEST` per line; older versions of that runbook are refused.
# floors = /etc/md-runbook/floors

# How many distinct signers from allowed_signers a runbook needs (author and reviewer: 2).
signers = 1

# syslog (tag md-runbook-gate), or a file the account can append to. Only syslog is out of
# the blocks' reach (they run as the account).
log = syslog

# The blocks' PATH: absolute, root-owned folders (the account's profile is never read).
path = /usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# The blocks' locale (the client's LANG and LC_* never reach them). auto: C.UTF-8, else C.
locale = auto

# The blocks' KUBECONFIG (absolute files separated by :). Without it, kubectl reads
# ~/.kube/config. The account's own KUBECONFIG never reaches a block.
# kubeconfig = /etc/md-runbook/kubeconfig

# The files with the account's key lines, as sshd_config's AuthorizedKeysFile names them
# (space-separated; %h is the home folder, %u the account, %U its uid, %% a %). Every line must
# run this gate with restrict, all signed (unsigned = refuse, no --unsigned=allow) or all
# unsigned. The default is sshd's:
# authorized_keys = %h/.ssh/authorized_keys %h/.ssh/authorized_keys2

# yes when sshd_config's ForceCommand runs this gate for the account with --sshd-force-command:
# then the key lines are not read, and unsigned above decides alone. Only from a root-owned
# file the account can't write, and only with that option; sshd_config needs DisableForwarding
# yes, PermitTTY no, PermitUserRC no and PermitUserEnvironment no.
# sshd_force_command = yes

# yes: at the start and end of each session, end every process of the account that belongs to
# no live session (a block's setsid or double-forked program, a cron job). Linux only. For an
# account used by the gate alone; recommended. Best-effort against a fork loop (a program that
# forks and exits again and again): one that also leaves its process group each time can slip
# through. If new ones keep coming for 5 seconds, the log says "sweep incomplete".
# kill_leftovers = no

# Each shell runs in a scope of its own: when it ends, everything in it ends too, a setsid or
# double-forked program as well.
#   auto:  scope where it works, else none (never bwrap: blocks keep sudo).
#   scope: a systemd scope of the account's user manager (pam_systemd, or loginctl
#          enable-linger). Needs cgroup v2 and Linux 5.14 or newer.
#   bwrap: a PID namespace of its own. Blocks can't use sudo or setuid programs there.
#   none:  the shell's process group only; kill_leftovers ends the rest.
# scope and bwrap are required when named: without them the gate doesn't start.
# isolation = auto

# Separated mode: the blocks run as unprivileged accounts of their own, not the gate's. Then they
# can't read the report token or the log. Each session leases a free account of the pool for its
# whole life, so sessions side by side can't reach each other; every process of that account
# ends at the start and end of the session. When all are in use, the next session refuses to
# start: make the pool as large as the sessions you run at once. It needs exactly this sudoers
# line, naming the whole pool (in any order), and no other rule for the gate's account (here
# support):
#   support ALL=(mdrb-cells-1,mdrb-cells-2,mdrb-cells-3,mdrb-cells-4) NOPASSWD: /usr/local/bin/md-runbook-gate __cells
# At the start of each session the gate checks the line, and that no account of the pool can read
# the token or the log. If a check fails, it refuses to start and says why. Run reports say
# gate_mode "separated". Leave it out for shared mode (the default).
# cells_accounts = mdrb-cells-1 mdrb-cells-2 mdrb-cells-3 mdrb-cells-4
# cells_account = NAME is a pool of one (one session at a time). Not together with
# cells_accounts.

# Where the blocks run: local (this host, the default) or kubernetes-job (the ops host in a
# cluster: each session's blocks in a Kubernetes Job of their own, in the gate's namespace,
# as job_service_account). It counts as separated. job_image: the Job's image, by default the
# gate's own pod's. At the start of each session the gate checks both service accounts and
# refuses to start if either has a right it shouldn't (apps/ops/README.md).
# cells_runner = kubernetes-job
# job_service_account = md-runbook-cells
# job_image = ghcr.io/smojon/md-runbook-ops:0.29.0
# job_audit_who = yes: the Kubernetes audit log names who ran each block (the Job's kubectl
# impersonates its own service account, with who in the user extra md-runbook.dev/operator).
# Needs apps/ops/kubernetes/impersonation.yaml. A block can change the name: the gate's log
# stays the authority (docs/features/kubernetes.md). Default no.
# job_audit_who = yes

# allow_no_group_kill (yes or no) is obsolete: the gate gives each shell a process group of its
# own. A gate.conf with it still works; each session logs a notice.

# The gate's own memory (not the blocks'), in MiB: a session that needs more ends. 0 for no
# limit.
# memory_limit = 512

# Under sshd the gate refuses a login shell other than sh, dash, ash, busybox, ksh, mksh, oksh
# or posh (bash reads ~/.bashrc first): make it /bin/sh. no: don't check (test servers only).
# login_shell_check = yes

# Run reports: at the end of each session, a summary of every signed runbook it ran (no
# outputs, no parameter values) to this address, in the background. https (http only for
# localhost). Never in a run's way: a failure is logged as a `report` event.
# report_to = https://runbooks.example.net/v1/runs
# A file holding the bearer token, this gate's own: one of the library server's
# RUNS_GATE_TOKENS, or RUNS_SEPARATED_GATE_TOKENS with cells_accounts (separated mode).
# report_token_file = /etc/md-runbook/report-token
