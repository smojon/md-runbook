# /etc/md-runbook/gate.conf: the policy of md-runbook-gate on this server.
# A key's own options (--unsigned=, --scopes=) override it for that key.

# Blocks that are not signed (or changed since signing): refuse, or allow (still logged).
unsigned = refuse

# Signed runbooks for these scopes run here, space-separated; * = any (runbooks without scopes
# run only where this is *).
scopes = *

# The publishers' keys (OpenSSH allowed_signers format, namespaces="md-runbook").
allowed_signers = /etc/md-runbook/allowed_signers

# Withdrawn releases: manifest sha256 hashes, one per line (md-runbook verify shows a runbook's).
# revoked = /etc/md-runbook/revoked

# Version floors: `NAME LOWEST` per line; older versions of that runbook are refused.
# floors = /etc/md-runbook/floors

# How many distinct signers from allowed_signers a runbook needs (author and reviewer: 2).
signers = 1

# syslog (tag md-runbook-gate), or a file the account can append to. Only syslog is out of
# the blocks' reach (they run as the account).
log = syslog

# The blocks' PATH: absolute, root-owned folders (the account's profile is never read).
path = /usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

# The blocks' locale (the client's LANG and LC_* never reach them). auto: C.UTF-8, else C.
locale = auto

# The blocks' KUBECONFIG (absolute files separated by :). Without it, kubectl reads
# ~/.kube/config. The account's own KUBECONFIG never reaches a block.
# kubeconfig = /etc/md-runbook/kubeconfig

# The files with the account's key lines, as sshd_config's AuthorizedKeysFile names them
# (space-separated; %h is the home folder, %u the account, %U its uid, %% a %). Every line must
# run this gate with restrict, all signed (unsigned = refuse, no --unsigned=allow) or all
# unsigned. The default is sshd's:
# authorized_keys = %h/.ssh/authorized_keys %h/.ssh/authorized_keys2

# yes when sshd_config's ForceCommand runs this gate for the account with --sshd-force-command:
# then the key lines are not read, and unsigned above decides alone. Only from a root-owned
# file the account can't write, and only with that option; sshd_config needs DisableForwarding
# yes, PermitTTY no, PermitUserRC no and PermitUserEnvironment no.
# sshd_force_command = yes

# yes: at the start and end of each session, end every process of the account that belongs to
# no live session (a block's setsid or double-forked program, a cron job). Linux only. For an
# account used by the gate alone; recommended. Best-effort against a fork loop (a program that
# forks and exits again and again): one that also leaves its process group each time can slip
# through. If new ones keep coming for 5 seconds, the log says "sweep incomplete".
# kill_leftovers = no

# Without setsid and perl the gate can't end a block's background programs, and refuses to
# start. yes: start anyway.
# allow_no_group_kill = no

# The gate's own memory (not the blocks'), in MiB of address space; 0 for no limit.
# memory_limit = 512

# Under sshd the gate refuses a login shell other than sh, dash, ash, busybox, ksh, mksh, oksh
# or posh (bash reads ~/.bashrc first): make it /bin/sh. no: don't check (test servers only).
# login_shell_check = yes

# Run reports: at the end of each session, a summary of every signed runbook it ran (no
# outputs, no parameter values) to this address, by curl, in the background. https (http only
# for localhost). Never in a run's way: a failure is logged as a `report` event.
# report_to = https://runbooks.example.net/v1/runs
# A file holding the bearer token (one of the library server's RUNS_GATE_TOKENS).
# report_token_file = /etc/md-runbook/report-token
