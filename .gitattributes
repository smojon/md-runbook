apps/gate/gate.conf.example text eol=lf
# The web image's start script runs in a Linux container from any checkout.
apps/web/*.sh text eol=lf
# The ops host image: files copied into a Linux container from any checkout.
apps/ops/** text eol=lf
# The probe image: files copied into a Linux container from any checkout.
apps/probe/** text eol=lf
